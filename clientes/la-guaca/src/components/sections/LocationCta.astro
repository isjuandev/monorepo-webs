---
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";

export interface Props {
  title: string;
  label?: string;
  text?: string;
  wazeLabel: string;
  mapsLabel: string;
}

const { title, label, text, wazeLabel, mapsLabel } = Astro.props;
---

<section class="section location-cta">
  <div class="container">
    <SectionHeading label={label} title={title} text={text}>
      <LinkButton href="waze" variant="primary" blockMobile>{wazeLabel}</LinkButton>
      <LinkButton href="maps">{mapsLabel}</LinkButton>
    </SectionHeading>
  </div>
</section>

<style>
  .location-cta :global(.heading__actions) {
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }

  @media (max-width: 809px) {
    .location-cta :global(.heading__actions) {
      width: 100%;
      flex-direction: column;
    }
  }
</style>
