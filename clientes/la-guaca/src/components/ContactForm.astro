---
import ArrowIcon from "@/components/ArrowIcon.astro";
import { siteConfig } from "@/config/site";
import { UI_LABELS } from "@/data/content";

const { form: copy } = UI_LABELS;
---

<form class="contact-form" data-contact-form data-whatsapp={siteConfig.contact.whatsapp ?? ""}>
  <div class="contact-form__grid">
    <label class="contact-form__field">
      <span class="t-small">{copy.name}</span>
      <input type="text" name="name" placeholder={copy.namePlaceholder} autocomplete="given-name" required />
    </label>
    <label class="contact-form__field contact-form__field--select">
      <span class="t-small">{copy.enquiryType}</span>
      <select name="type" required>
        <option value="" disabled selected>{copy.selectOption}</option>
        {copy.enquiryTypes.map((type) => <option value={type}>{type}</option>)}
      </select>
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" />
      </svg>
    </label>
    <label class="contact-form__field contact-form__field--full">
      <span class="t-small">{copy.when}</span>
      <input type="text" name="when" placeholder={copy.whenPlaceholder} />
    </label>
    <label class="contact-form__field contact-form__field--full">
      <span class="t-small">{copy.message}</span>
      <textarea name="message" rows="4" placeholder={copy.messagePlaceholder}></textarea>
    </label>
  </div>
  <button type="submit" class="btn btn--primary contact-form__submit">
    {copy.submit}
    <ArrowIcon direction="external" />
  </button>
  <p class="t-small contact-form__status" data-form-status aria-live="polite"></p>
</form>

<style>
  .contact-form {
    width: 100%;
    max-width: 680px;
    margin: 80px auto 0;
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-line-dark);
  }

  .contact-form__field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line-dark);
  }

  .contact-form__field:nth-child(even) {
    padding-left: 16px;
    border-left: 1px solid var(--color-line-dark);
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__field.contact-form__field--full {
    padding-left: 0;
    border-left: 0;
  }

  .contact-form__field option {
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .contact-form__field input,
  .contact-form__field select,
  .contact-form__field textarea {
    width: 100%;
    padding: 4px 0;
    border: 0;
    background: transparent;
    font-size: 18px;
    letter-spacing: -0.01em;
    outline: none;
    appearance: none;
    border-radius: 0;
    resize: vertical;
  }

  .contact-form__field textarea {
    min-height: 96px;
  }

  .contact-form__field ::placeholder {
    color: var(--color-muted);
  }

  .contact-form__field:focus-within {
    border-bottom-color: var(--color-text);
  }

  .contact-form__field--select svg {
    position: absolute;
    right: 0;
    bottom: 24px;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }

  .contact-form__submit {
    width: 100%;
    margin-top: 32px;
  }

  .contact-form__status {
    min-height: 1.44em;
    margin-top: 16px;
    text-align: center;
  }

  @media (max-width: 809px) {
    .contact-form {
      margin-top: 56px;
    }

    .contact-form__grid {
      grid-template-columns: 1fr;
    }

    .contact-form__field:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>

<script>
  import { buildWhatsAppUrl } from "@repo/utils";
  import { UI_LABELS } from "@/data/content";

  // Sitio estático: el formulario abre WhatsApp con la consulta ya redactada.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-contact-form]")) {
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const phone = form.dataset.whatsapp;
      if (!phone) {
        if (status) status.textContent = UI_LABELS.form.missingWhatsapp;
        return;
      }
      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? "").trim();
      const message = UI_LABELS.form.whatsappMessage(
        value("type"),
        value("name"),
        value("when"),
        value("message")
      );
      window.open(buildWhatsAppUrl(phone, message), "_blank", "noopener,noreferrer");
      if (status) status.textContent = UI_LABELS.form.opening;
    });
  }
</script>
