{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!docs/**", "!cliente.json", "!plantilla.json"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "outputs": []
    },
    "@apps/cms#test": {
      "inputs": ["$TURBO_DEFAULT$", "../../scripts/lib/**", "../cms-core/src/**"],
      "outputs": []
    },
    "@apps/cms#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!cliente.json",
        "!plantilla.json",
        "../../scripts/lib/**",
        "../cms-core/src/**"
      ],
      "outputs": ["dist/**", ".astro/**"]
    },
    "@repo/cms-core#check": {
      "dependsOn": ["^check"],
      "inputs": ["$TURBO_DEFAULT$", "../../scripts/lib/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
