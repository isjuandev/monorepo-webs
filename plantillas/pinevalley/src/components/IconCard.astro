---
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/data/icons";

export interface Props {
  icon: IconName;
  label: string;
  /** Texto secundario (p. ej. distancia en minutos) */
  meta?: string;
}

const { icon, label, meta } = Astro.props;
---

<li class="icon-card card">
  <Icon name={icon} />
  <span class="icon-card__label">{label}</span>
  {meta && <span class="icon-card__meta">{meta}</span>}
</li>

<style>
  .icon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 101px;
    padding: 24px;
    text-align: center;
    color: var(--color-text);
  }

  .icon-card__label {
    font-size: 16px;
    line-height: 1.2;
  }

  .icon-card__meta {
    margin-top: -1px;
    font-size: 14px;
    line-height: 1.2;
    color: var(--color-subtle);
  }

  @media (max-width: 809px) {
    .icon-card {
      min-height: 98px;
      padding: 24px 16px;
    }

    .icon-card__label {
      font-size: 14px;
    }
  }
</style>
