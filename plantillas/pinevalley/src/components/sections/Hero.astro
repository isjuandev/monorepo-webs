---
import Button from "@/components/Button.astro";
import Lines from "@/components/Lines.astro";
import { BOOKING, HERO } from "@/data/content";
---

<section class="hero" id={HERO.id} data-hero>
  <img
    class="hero__bg"
    src={HERO.background.src}
    alt={HERO.background.alt}
    width="1084"
    height="1300"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__content" data-scroll-speed="0.5">
    <div class="hero__inner" data-appear="0.4">
      <div class="hero__trust">
        <ul class="hero__avatars">
          {
            HERO.avatars.map((avatar) => (
              <li>
                <img src={avatar.src} alt={avatar.alt} width="24" height="24" loading="eager" />
              </li>
            ))
          }
        </ul>
        <p>{HERO.trustedBy}</p>
      </div>
      <h1 class="hero__title"><Lines text={HERO.title} keep /></h1>
      <p class="hero__text"><Lines text={HERO.text} /></p>
      <Button href={`/#${BOOKING.intro.id}`} label={HERO.cta} variant="light" />
    </div>
  </div>
  <img
    class="hero__fg"
    src={HERO.foreground.src}
    alt={HERO.foreground.alt}
    width="1084"
    height="1300"
    decoding="async"
  />
</section>

<style>
  /* Escena de profundidad: cielo + título (parallax a 0.5×) + recorte de la casa por delante */
  .hero {
    position: relative;
    height: calc(100vw * 1.2);
    overflow: hidden;
    background: var(--color-bg);
  }

  .hero__bg,
  .hero__fg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero__fg {
    z-index: 2;
    pointer-events: none;
  }

  .hero__content {
    --scroll-shift: 0px;
    position: absolute;
    top: 144px;
    left: 50%;
    z-index: 1;
    width: min(720px, 100%);
    transform: translate(-50%, var(--scroll-shift));
    will-change: transform;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 0 var(--gutter);
    text-align: center;
    color: var(--color-on-image);
  }

  .hero__trust {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    line-height: 1.2;
  }

  .hero__avatars {
    display: flex;
  }

  .hero__avatars li {
    width: 28px;
    height: 28px;
    padding: 2px;
    border-radius: 50%;
    background: var(--color-on-image);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero__avatars li + li {
    margin-left: -8px;
  }

  .hero__avatars li:hover {
    position: relative;
    transform: scale(1.08);
  }

  .hero__avatars img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  .hero__title {
    max-width: 672px;
    font-family: var(--font-display);
    font-size: 60px;
    font-weight: 600;
    line-height: 1.2;
    text-wrap: balance;
  }

  .hero__text {
    max-width: 520px;
    margin-bottom: 16px;
    text-wrap: balance;
    font-size: 16px;
    line-height: 1.2;
  }

  @media (max-width: 1199px) {
    .hero {
      height: 1200px;
    }

    .hero__content {
      top: 120px;
    }

    .hero__title {
      font-size: 48px;
    }

    .hero__text {
      font-size: 14px;
    }
  }

  @media (max-width: 809px) {
    .hero {
      height: 1100px;
    }

    .hero__content {
      top: 96px;
    }

    .hero__title {
      font-size: 36px;
    }

    .hero__text {
      max-width: 342px;
    }
  }
</style>
