---
import Lines from "@/components/Lines.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import Stars from "@/components/Stars.astro";
import { REVIEWS } from "@/data/content";
---

<section class="section reviews" id={REVIEWS.intro.id}>
  <div class="section__inner">
    <div data-reveal>
      <SectionIntro intro={REVIEWS.intro} />
    </div>
    <ul class="reviews__grid">
      {
        REVIEWS.items.map((review) => (
          <li class="review card">
            <div class="review__profile">
              <img
                src={review.avatar.src}
                alt={review.avatar.alt}
                width="50"
                height="50"
                loading="lazy"
                decoding="async"
              />
              <div>
                <h3 class="review__name">{review.name}</h3>
                <p class="review__stayed">{review.stayed}</p>
              </div>
            </div>
            <Stars count={review.rating} />
            <blockquote class="review__quote">
              <Lines text={review.quote} />
            </blockquote>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px;
  }

  .review__profile {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .review__profile img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
  }

  .review__profile div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .review__name {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
  }

  .review__stayed {
    font-size: 12px;
    line-height: 1.2;
    color: var(--color-subtle);
  }

  .review__quote {
    text-wrap: pretty;
    font-size: 16px;
    line-height: 1.2;
    color: var(--color-muted);
  }

  @media (max-width: 1199px) {
    .reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 809px) {
    .reviews__grid {
      grid-template-columns: 1fr;
    }

    .review__quote {
    text-wrap: pretty;
      font-size: 14px;
    }
  }
</style>
