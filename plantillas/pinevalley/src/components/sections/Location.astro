---
import Icon from "@/components/Icon.astro";
import IconCard from "@/components/IconCard.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import { siteConfig } from "@/config/site";
import { LOCATION, UI_LABELS } from "@/data/content";

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(siteConfig.contact.mapQuery)}&z=15&output=embed`;
---

<section class="section location" id={LOCATION.intro.id}>
  <div class="section__inner">
    <div data-reveal>
      <SectionIntro intro={LOCATION.intro} />
    </div>
    <div class="location__body">
      <div class="location__map">
        <iframe
          src={mapSrc}
          title={UI_LABELS.mapTitle}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          data-lenis-prevent></iframe>
      </div>
      <address class="location__card">
        <a class="location__line" href={siteConfig.contact.mapsUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="pin" size={20} />
          <span class="visually-hidden">{UI_LABELS.address}:</span>
          {siteConfig.contact.address}
        </a>
        <a class="location__line" href={siteConfig.contact.phoneHref}>
          <span class="visually-hidden">{UI_LABELS.phone}:</span>
          {siteConfig.contact.phone}
        </a>
      </address>
      <ul class="location__grid">
        {
          LOCATION.nearby.map((place) => (
            <IconCard icon={place.icon} label={place.name} meta={place.time} />
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .location__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .location__map {
    height: 400px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-placeholder);
  }

  .location__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .location__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-style: normal;
  }

  .location__line {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    line-height: 1.2;
  }

  .location__line:hover {
    text-decoration: underline;
  }

  .location__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .location__grid :global(.icon-card) {
    min-height: 128px;
  }

  @media (max-width: 809px) {
    .location__line {
      align-items: flex-start;
    }

    .location__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
