---
import BrandMark from "@/components/BrandMark.astro";
import ClosingCta from "@/components/ClosingCta.astro";
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import HomeHero from "@/components/sections/HomeHero.astro";
import InfoGrid from "@/components/sections/InfoGrid.astro";
import StaggeredGallery from "@/components/sections/StaggeredGallery.astro";
import { siteConfig } from "@/config/site";
import { DISTANCES, IMAGES, PAGES, PLACES, UI_LABELS } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const page = PAGES.retreat;
---

<BaseLayout
  title={`${page.meta.title} | ${siteConfig.name}`}
  description={page.meta.description}
>
  <HomeHero
    image={IMAGES.retreatHero}
    label={page.hero.label}
    title={page.hero.title}
    sideLeft={page.hero.sideLeft}
    sideRight={page.hero.sideRight}
    intro={page.hero.intro}
  />

  <section class="section story">
    <div class="container">
      <SectionHeading title={page.storyTitle} />
      <div class="story__mark" data-reveal>
        <BrandMark />
      </div>
    </div>
  </section>

  <StaggeredGallery
    images={IMAGES.retreatStory}
    captions={page.storyCaptions}
  />

  <section class="section design">
    <div class="container">
      <SectionHeading
        label={page.design.label}
        title={page.design.title}
        text={page.design.text}
      />
      <ul class="design__points" data-reveal>
        {page.design.points.map((point) => <li class="t-lead">{point}</li>)}
      </ul>
      <div class="design__images">
        <div class="media design__img design__img--a" data-reveal>
          <img src={IMAGES.retreatDesign[0]} alt="" loading="lazy" />
        </div>
        <div class="media design__img design__img--b" data-reveal style="--reveal-delay: 0.1s">
          <img src={IMAGES.retreatDesign[1]} alt="" loading="lazy" />
        </div>
        <div class="media design__img design__img--c" data-reveal style="--reveal-delay: 0.2s">
          <img src={IMAGES.retreatDesign[2]} alt="" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <FeatureGrid title={page.ourWay.title} items={page.ourWay.items} />

  <section class="setting">
    <div class="setting__block setting__block--left">
      <div class="setting__text">
        <SectionHeading
          align="left"
          label={page.sustainability.label}
          title={page.sustainability.title}
          text={page.sustainability.text}
        />
        <ul class="setting__list" data-reveal>
          {
            page.sustainability.items.map((item) => (
              <li class="t-lead">
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="m2 6.5 2.5 2.5L10 3.5" fill="none" stroke="currentColor" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="media setting__img setting__img--left">
        <img src={IMAGES.retreatSustainability} alt="" loading="lazy" />
      </div>
    </div>
    <div class="setting__block setting__block--right">
      <div class="media setting__img setting__img--right">
        <img src={IMAGES.retreatSetting} alt="" loading="lazy" />
      </div>
      <div class="setting__text setting__text--right">
        <SectionHeading
          align="left"
          label={page.setting.label}
          title={page.setting.title}
          text={page.setting.text}
        />
        <img src={IMAGES.retreatMap} alt={UI_LABELS.mapAlt} class="setting__map" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section places">
    <div class="container">
      <SectionHeading label={page.places.label} title={page.places.title} />
      <ul class="places__list">
        {
          PLACES.map((place) => (
            <li class="places__item" data-reveal>
              <div class="media places__img">
                <img src={place.image} alt="" loading="lazy" />
              </div>
              <p class="t-display places__name">{place.name}</p>
              <div class="places__info">
                <p class="t-body">{place.text}</p>
                <LinkButton href="maps">{UI_LABELS.openInMaps}</LinkButton>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="places__footer" data-reveal>
        <p class="t-lead">{page.places.footer}</p>
        <LinkButton href="maps">{page.places.cta}</LinkButton>
      </div>
    </div>
  </section>

  <InfoGrid
    tone="brown"
    label={page.directions.label}
    title={page.directions.title}
    items={DISTANCES}
    image={IMAGES.retreatRoad}
    imageSize="medium"
    large
  />

  <ClosingCta />
</BaseLayout>

<style>
  .story {
    padding-bottom: 0;
  }

  .story__mark {
    display: flex;
    justify-content: center;
    margin-top: 120px;
    color: var(--color-text);
  }

  .design {
    padding-bottom: 0;
  }

  .design__points {
    display: flex;
    justify-content: center;
    margin-top: 120px;
  }

  .design__points li {
    padding: 0 40px;
  }

  .design__points li + li {
    border-left: 1px solid var(--color-line-dark);
  }

  .design__images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 16px;
    margin-top: 40px;
  }

  .design__img--a {
    aspect-ratio: 4 / 3;
  }

  .design__img--b {
    aspect-ratio: 3 / 4;
  }

  .design__img--c {
    aspect-ratio: 1 / 1;
  }

  .setting {
    padding-top: 120px;
  }

  .setting__block {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .setting__text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 120px var(--gutter) 120px 148px;
  }

  .setting__text--right {
    padding: 120px var(--gutter) 120px 124px;
  }

  .setting__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .setting__list li {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .setting__list svg {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .setting__img--left {
    grid-column: 1;
    grid-row: 2;
    aspect-ratio: 720 / 1171;
  }

  .setting__block--left .setting__text {
    grid-column: 1;
    grid-row: 1;
  }

  .setting__block--left {
    grid-template-rows: auto auto;
  }

  .setting__block--right {
    margin-top: -1080px;
    pointer-events: none;
  }

  .setting__block--right > * {
    pointer-events: auto;
  }

  .setting__img--right {
    grid-column: 2;
    width: calc(100% - 120px);
    margin-left: 120px;
    aspect-ratio: 600 / 960;
  }

  .setting__block--right .setting__text {
    grid-column: 2;
    grid-row: 2;
  }

  .setting__map {
    width: 360px;
    max-width: 100%;
    margin-top: 56px;
  }

  .places__list {
    margin-top: 80px;
    border-top: 1px solid var(--color-line-dark);
  }

  .places__item {
    display: grid;
    grid-template-columns: 171px 1fr 280px;
    align-items: start;
    gap: 40px;
    padding: 32px 0;
    border-bottom: 1px solid var(--color-line-dark);
  }

  .places__img {
    aspect-ratio: 4 / 3;
  }

  .places__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-left: 52px;
  }

  .places__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 480px;
    margin: 120px auto 0;
    text-align: center;
  }

  @media (max-width: 1199px) {
    .setting__block,
    .setting__block--right {
      grid-template-columns: 1fr;
      margin-top: 0;
    }

    .setting__img--left,
    .setting__img--right {
      grid-column: 1;
      grid-row: auto;
      width: 100%;
      margin-left: 0;
      aspect-ratio: 4 / 3;
    }

    .setting__block--right .setting__text,
    .setting__block--left .setting__text {
      grid-column: 1;
      grid-row: auto;
    }

    .setting__text,
    .setting__text--right {
      padding: 80px var(--gutter);
    }

    .places__item {
      grid-template-columns: 120px 1fr;
    }

    .places__info {
      grid-column: 2;
      margin-left: 0;
    }
  }

  @media (max-width: 809px) {
    .design__points {
      flex-direction: column;
      align-items: center;
      gap: 12px;
      margin-top: 56px;
    }

    .design__points li + li {
      border-left: 0;
    }

    .design__images {
      grid-template-columns: 1fr;
    }

    .places__item {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .places__img {
      width: 120px;
    }

    .places__info {
      grid-column: 1;
    }
  }
</style>
