---
import { siteConfig } from "@/config/site";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["brand-mark", className]}>
  <svg class="brand-mark__icon" viewBox="0 0 40 40" aria-hidden="true">
    {
      Array.from({ length: 8 }, (_, i) => (
        <ellipse
          cx="20"
          cy="10"
          rx="3.2"
          ry="9"
          fill="currentColor"
          transform={`rotate(${i * 45} 20 20)`}
        />
      ))
    }
  </svg>
  <p class="t-logo">{siteConfig.name}</p>
  <p class="t-label">Est. {siteConfig.established}</p>
</div>

<style>
  .brand-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .brand-mark__icon {
    width: 40px;
    height: 40px;
    margin-bottom: 24px;
  }
</style>
