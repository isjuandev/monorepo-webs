---
import Icon from "@/components/Icon.astro";
import SplitHeading from "@/components/SplitHeading.astro";
import { PLAN_HREF } from "@/config/site";
import { LONGEVITY, PROGRAM_FEATURES, PROGRAMS } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPrice } from "@/lib/format";

const { hero, stats, movements, pricing, team, teamTitle, faq } = LONGEVITY;
const [heroLead, ...heroAccent] = hero.title;
const [faqLead, faqAccent] = faq.title;
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout page={LONGEVITY.meta.seoTitle} description={LONGEVITY.meta.description} headerTone="dark" jsonLd={faqJsonLd}>
  <section class="lx-hero" data-tone="dark">
    <div class="container lx-hero__inner">
      <div class="lx-hero__copy">
        <h1 class="display display-xl">
          <span data-load style="--load-delay: 0.15s">{heroLead}</span>
          {
            heroAccent.map((line, index) => (
              <span class="accent" data-load style={`--load-delay: ${0.28 + index * 0.12}s`}>
                {line}
              </span>
            ))
          }
        </h1>
        <p class="lede" data-load style="--load-delay: 0.55s">{hero.text}</p>
        <div class="lx-hero__actions" data-load style="--load-delay: 0.65s">
          <a class="btn btn--accent" href={hero.primary.href}>
            {hero.primary.label}
            <Icon name="arrow-right" />
          </a>
          <a class="btn btn--ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
        </div>
      </div>
      <div class="lx-hero__visual" data-load style="--load-delay: 0.3s">
        <div class="media media--arch lx-hero__arch">
          <img src={hero.image.src} alt={hero.image.alt} width="896" height="1200" fetchpriority="high" decoding="async" />
        </div>
        <p class="lx-hero__badge">
          <span>{hero.badge.label}</span>
          {hero.badge.value}
        </p>
      </div>
    </div>
  </section>

  <section class="lx-stats" data-tone="light">
    <dl class="container lx-stats__grid">
      {
        stats.map((stat, index) => (
          <div data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="lx-moves" data-tone="light">
    <div class="container">
      <SplitHeading title={movements.title} size="m" />
      <ol class="lx-moves__line">
        {
          movements.steps.map((step, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
              <span class:list={["lx-moves__dot", { "is-first": index === 0 }]} aria-hidden="true" />
              <h3 class="lx-moves__name">
                <span>{step.numeral}</span>
                {step.name}
              </h3>
              <p class="lx-moves__moment">{step.moment}</p>
              <p class="lx-moves__text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="lx-pricing" id="compare" data-tone="light" data-pricing>
    <div class="container">
      <div class="lx-pricing__header">
        <SplitHeading title={pricing.title} size="s" />
        <div class="lx-toggle" role="group" aria-label={pricing.toggleLabel} data-reveal>
          <button type="button" aria-pressed="true" data-price-mode="person">{pricing.perPerson}</button>
          <button type="button" aria-pressed="false" data-price-mode="couple">{pricing.perCouple}</button>
        </div>
      </div>
      <ul class="lx-pricing__cards">
        {
          PROGRAMS.map((program, index) => (
            <li class:list={["price-card", { "price-card--featured": program.featured }]} data-tone={program.featured ? "dark" : "light"} data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
              <div class="price-card__top">
                <span class="price-card__numeral">{program.numeral}</span>
                {program.featured && <span class="price-card__badge">{pricing.featured}</span>}
              </div>
              <h3 class="price-card__name">{program.name}</h3>
              <p class="price-card__tagline">{program.tagline}</p>
              <p class="price-card__price">
                <strong data-person={formatPrice(program.pricePerson)} data-couple={formatPrice(program.pricePerCouple)} data-price>
                  {formatPrice(program.pricePerson)}
                </strong>
                <span>{pricing.nightsSuffix(program.nights)}</span>
              </p>
              <ul class="price-card__features">
                {PROGRAM_FEATURES.map((feature, row) => (
                  <li class:list={{ "is-off": !program.includes[row] }}>
                    <Icon name={program.includes[row] ? "check" : "minus"} size={14} />
                    {feature}
                  </li>
                ))}
              </ul>
              <a class:list={["btn", "btn--block", program.featured ? "btn--accent" : "btn--ghost"]} href={`${PLAN_HREF}?program=${program.slug}`}>
                {pricing.cta(program.name)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lx-team" data-tone="light">
    <div class="container">
      <SplitHeading title={teamTitle} size="s" inline />
      <ul class="lx-team__grid">
        {
          team.map((member, index) => (
            <li class="member" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
              <div class="media member__media">
                <img src={member.image.src} alt={member.image.alt} width="440" height="560" loading="lazy" decoding="async" />
              </div>
              <h3 class="member__name">{member.name}</h3>
              <div class="chip-row">
                {member.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
              <p class="member__quote">{member.quote}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lx-faq" data-tone="light">
    <div class="container lx-faq__inner">
      <div class="lx-faq__intro">
        <h2 class="display display-s" data-reveal>
          <span>{faqLead}</span>
          <span>{faqAccent}</span>
        </h2>
        <p class="lx-faq__text" data-reveal>{faq.text}</p>
      </div>
      <ul class="lx-faq__list" data-accordion>
        {
          faq.items.map((item, index) => (
            <li class:list={["faq", { "is-open": index === 0 }]} data-accordion-item>
              <h3>
                <button
                  type="button"
                  class="faq__question"
                  aria-expanded={index === 0 ? "true" : "false"}
                  aria-controls={`faq-${index}`}
                  data-accordion-toggle
                >
                  {item.question}
                  <Icon name="plus" size={18} class="faq__plus" />
                  <Icon name="minus" size={18} class="faq__minus" />
                </button>
              </h3>
              <div class="faq__panel" id={`faq-${index}`} data-accordion-panel>
                <p>{item.answer}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  import "@/scripts/accordion";

  // Selector "Por persona / Por pareja": cambia los precios de las tres tarjetas.
  for (const root of document.querySelectorAll<HTMLElement>("[data-pricing]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-price-mode]")];
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const mode = button.dataset.priceMode === "couple" ? "couple" : "person";
        for (const other of buttons) other.setAttribute("aria-pressed", String(other === button));
        for (const price of root.querySelectorAll<HTMLElement>("[data-price]")) {
          price.textContent = price.dataset[mode] ?? "";
          price.animate?.([{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], {
            duration: 400,
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          });
        }
      });
    }
  }
</script>

<style>
  .lx-hero {
    padding: 150px 0 90px;
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .lx-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: 60px;
    align-items: center;
  }

  .lx-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  .lx-hero__copy .lede {
    max-width: 460px;
    font-size: 18px;
  }

  .lx-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .lx-hero__visual {
    position: relative;
  }

  .lx-hero__arch {
    aspect-ratio: 560 / 720;
  }

  .lx-hero__badge {
    position: absolute;
    left: -70px;
    bottom: 110px;
    display: grid;
    place-content: center;
    width: 140px;
    height: 140px;
    border: 1px solid rgb(245 237 225 / 0.3);
    border-radius: 50%;
    background: rgb(42 29 20 / 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 13px;
    text-align: center;
  }

  .lx-hero__badge span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--color-on-dark-muted);
  }

  .lx-stats {
    padding: 60px 0;
    background: var(--color-sand-deep);
  }

  .lx-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .lx-stats__grid div {
    display: flex;
    flex-direction: column-reverse;
    gap: 14px;
    padding: 0 28px;
    border-left: 1px solid var(--color-line);
  }

  .lx-stats__grid div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .lx-stats dd {
    font-family: var(--font-display);
    font-size: clamp(44px, 4.5vw, 65px);
    font-weight: 300;
    line-height: 1;
  }

  .lx-stats dt {
    font-size: 15px;
    color: var(--color-muted);
  }

  .lx-moves {
    padding: 140px 0;
  }

  .lx-moves__line {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid rgb(200 100 44 / 0.4);
  }

  .lx-moves__line li {
    position: relative;
  }

  .lx-moves__dot {
    position: absolute;
    top: -47px;
    left: 0;
    width: 14px;
    height: 14px;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .lx-moves__dot.is-first {
    background: var(--color-accent);
  }

  .lx-moves__name {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.15;
  }

  .lx-moves__name span {
    font-size: 26px;
    font-style: italic;
    color: var(--color-accent);
  }

  .lx-moves__moment {
    margin: 8px 0 16px;
    font-size: 10px;
    color: var(--color-subtle);
  }

  .lx-moves__text {
    max-width: 300px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .lx-pricing {
    padding: 140px 0;
    background: var(--color-sand-deep);
    scroll-margin-top: 40px;
  }

  .lx-pricing__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 56px;
  }

  .lx-toggle {
    display: flex;
    padding: 4px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: rgb(42 29 20 / 0.05);
  }

  .lx-toggle button {
    min-height: 40px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .lx-toggle button[aria-pressed="true"] {
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .lx-pricing__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .price-card {
    display: flex;
    flex-direction: column;
    padding: 36px 32px 32px;
    border-radius: 28px;
    background: var(--color-bg);
  }

  .price-card--featured {
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .price-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 28px;
  }

  .price-card__numeral {
    font-family: var(--font-display);
    font-size: 22px;
    font-style: italic;
    color: var(--color-accent);
  }

  .price-card--featured .price-card__numeral {
    color: var(--color-glow);
  }

  .price-card__badge {
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-glow);
    font-size: 10px;
    color: var(--color-primary);
  }

  .price-card__name {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: clamp(44px, 4.2vw, 60px);
    font-weight: 400;
    line-height: 1.05;
  }

  .price-card__tagline {
    font-size: 15px;
    color: var(--color-muted);
  }

  .price-card--featured .price-card__tagline,
  .price-card--featured .price-card__price span {
    color: rgb(245 237 225 / 0.65);
  }

  .price-card__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 36px 0 24px;
  }

  .price-card__price strong {
    font-family: var(--font-display);
    font-size: 45px;
    font-weight: 400;
    line-height: 1;
  }

  .price-card__price span {
    font-size: 15px;
    color: var(--color-muted);
  }

  .price-card__features {
    flex: 1;
    margin-bottom: 28px;
    border-top: 1px solid var(--color-line);
  }

  .price-card__features li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 15px;
  }

  .price-card--featured .price-card__features,
  .price-card--featured .price-card__features li {
    border-color: rgb(245 237 225 / 0.14);
  }

  .price-card__features :global(svg) {
    color: var(--color-accent);
  }

  .price-card__features li.is-off {
    color: var(--color-subtle);
  }

  .price-card__features li.is-off :global(svg) {
    color: currentColor;
  }

  .lx-team {
    padding: 140px 0;
  }

  .lx-team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 64px;
  }

  .member {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .member__media {
    width: 100%;
    aspect-ratio: 440 / 560;
    margin-bottom: 10px;
    border-radius: var(--radius-sm);
  }

  .member__name {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
  }

  .member__quote {
    font-family: var(--font-display);
    font-size: 18px;
    font-style: italic;
    line-height: 1.4;
    color: var(--color-accent);
  }

  .lx-faq {
    padding: 140px 0;
    background: var(--color-sand-deep);
  }

  .lx-faq__inner {
    display: grid;
    grid-template-columns: 420px minmax(0, 1fr);
    gap: 80px;
    align-items: start;
  }

  .lx-faq__text {
    max-width: 300px;
    margin-top: 28px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .lx-faq__list {
    border-top: 1px solid var(--color-line);
  }

  .faq {
    border-bottom: 1px solid var(--color-line);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 24px 0;
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.25;
    text-align: left;
  }

  .faq__question :global(svg) {
    flex: none;
    color: var(--color-accent);
  }

  .faq :global(.faq__minus),
  .faq:global(.is-open) :global(.faq__plus) {
    display: none;
  }

  .faq:global(.is-open) :global(.faq__minus) {
    display: block;
  }

  .faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-out);
  }

  .faq:global(.is-open) .faq__panel {
    grid-template-rows: 1fr;
  }

  .faq__panel p {
    min-height: 0;
    max-width: 640px;
    overflow: hidden;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .faq:global(.is-open) .faq__panel p {
    padding-bottom: 26px;
  }

  @media (max-width: 1100px) {
    .lx-pricing__cards {
      grid-template-columns: 1fr;
      max-width: 520px;
    }

    .lx-faq__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 999px) {
    .lx-hero__inner {
      grid-template-columns: 1fr;
    }

    .lx-hero__visual {
      width: 100%;
      max-width: 520px;
      margin-left: auto;
    }

    .lx-hero__badge {
      left: -16px;
      width: 116px;
      height: 116px;
    }

    .lx-moves__line {
      grid-template-columns: 1fr 1fr;
      row-gap: 56px;
    }

    .lx-team__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 809px) {
    .lx-hero {
      padding: 120px 0 72px;
    }

    .lx-stats__grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }

    .lx-stats__grid div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .lx-moves,
    .lx-pricing,
    .lx-team,
    .lx-faq {
      padding: 100px 0;
    }

    .lx-moves__line {
      grid-template-columns: 1fr;
      padding: 0 0 0 28px;
      border-top: 0;
      border-left: 1px solid rgb(200 100 44 / 0.4);
    }

    .lx-moves__dot {
      top: 10px;
      left: -36px;
    }

    .lx-pricing__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .lx-team__grid {
      grid-template-columns: 1fr;
    }

    .faq__question {
      font-size: 22px;
    }
  }
</style>
