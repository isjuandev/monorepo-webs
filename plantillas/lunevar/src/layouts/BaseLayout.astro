---
import SEO from "@repo/ui/astro/SEO.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { pageTitle, siteConfig } from "@/config/site";
import { UI_LABELS } from "@/data/content";
import "@/styles/theme.css";
import "@/styles/global.css";

export interface Props {
  /** Nombre de la página; se compone como "Página — <marca>" */
  page?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Tono de la cabecera sobre el primer bloque: "dark" = texto claro sobre foto/fondo oscuro */
  headerTone?: "light" | "dark";
  /** Tipo de página para Open Graph y JSON-LD adicional */
  jsonLd?: Record<string, unknown>;
}

const {
  page,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  noindex = false,
  headerTone = "light",
  jsonLd: pageJsonLd,
} = Astro.props;

const title = pageTitle(page);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Resort",
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  telephone: siteConfig.contact.phone,
  email: siteConfig.contact.email,
  address: siteConfig.contact.address,
  image: new URL(siteConfig.ogImage ?? "/images/og-image.jpg", siteConfig.url).href,
  sameAs: [siteConfig.socials.instagram],
};
---

<!doctype html>
<html lang={siteConfig.locale?.split("_")[0] ?? "es"}>
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      locale={siteConfig.locale}
      siteName={siteConfig.name}
      noindex={noindex}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      siteConfig.preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <meta name="theme-color" content={siteConfig.themeColor} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {pageJsonLd && <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />}
  </head>
  <body>
    <a href="#contenido" class="skip-link">{UI_LABELS.skipToContent}</a>
    <SiteHeader tone={headerTone} />
    <main id="contenido" class="site-main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "@/scripts/motion";
      import "@/scripts/sun-clock";
    </script>
  </body>
</html>

<style>
  /* El contenido queda por encima del pie, que se descubre al llegar al final (ver SiteFooter). */
  .site-main {
    position: relative;
    z-index: 1;
    background: var(--color-bg);
  }
</style>
