---
import { siteConfig } from "@/config/site";
import { UI_LABELS } from "@/data/content";

export interface Props {
  /** "light" = campo crema y botón oscuro (pie); "dark" = campo translúcido y botón cobre (diario) */
  variant?: "light" | "dark";
}

/**
 * Suscripción a las cartas. Sitio estático: el envío abre el correo del visitante con la solicitud
 * dirigida a `contact.email` y muestra una confirmación.
 */
const { variant = "light" } = Astro.props;
---

<form
  class:list={["newsletter", `newsletter--${variant}`]}
  data-newsletter
  data-to={siteConfig.contact.email}
  data-subject={UI_LABELS.newsletterSubject}
  novalidate
>
  <label class="visually-hidden" for={`newsletter-${variant}`}>{UI_LABELS.newsletterEmail}</label>
  <input
    id={`newsletter-${variant}`}
    type="email"
    name="email"
    required
    autocomplete="email"
    placeholder={UI_LABELS.newsletterEmail}
  />
  <button type="submit">{UI_LABELS.newsletterSubmit}</button>
  <p class="newsletter__status" role="status" data-sent={UI_LABELS.newsletterSent}></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-newsletter]")) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>("input[type='email']");
      const status = form.querySelector<HTMLElement>(".newsletter__status");
      if (!input || !input.checkValidity()) {
        input?.reportValidity();
        return;
      }
      const { to = "", subject = "" } = form.dataset;
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(input.value)}`;
      if (status) status.textContent = status.dataset.sent ?? "";
      form.reset();
    });
  }
</script>

<style>
  .newsletter {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 440px;
    min-height: 56px;
    padding: 6px 6px 6px 22px;
    border-radius: var(--radius-pill);
  }

  .newsletter--light {
    border: 1px solid rgb(42 29 20 / 0.08);
    background: rgb(251 246 238 / 0.7);
  }

  .newsletter--dark {
    border: 1px solid rgb(245 237 225 / 0.15);
    background: rgb(245 237 225 / 0.06);
    color: var(--color-on-dark);
  }

  .newsletter input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-size: 15px;
    outline: none;
  }

  .newsletter input::placeholder {
    color: currentColor;
    opacity: 0.55;
  }

  .newsletter:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .newsletter button {
    min-height: 44px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    transition: background-color 0.3s var(--ease-out);
  }

  .newsletter--light button {
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .newsletter--dark button {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .newsletter--dark button:hover {
    background: var(--color-accent-deep);
  }

  .newsletter__status {
    position: absolute;
    top: calc(100% + 10px);
    left: 22px;
    font-size: 13px;
    opacity: 0.8;
  }
</style>
