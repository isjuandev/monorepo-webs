---
import type { ImageAsset, SplitTitle } from "@/data/content";

export interface Props {
  title: SplitTitle;
  image: ImageAsset;
  /** Alto mínimo de la cabecera */
  size?: "tall" | "medium";
}

/**
 * Cabecera a sangre de las subpáginas (Suites, Gastronomía): foto con sombra inferior, titular
 * display en dos líneas abajo a la izquierda y un hueco a la derecha (`<slot />`) para cifras.
 */
const { title, image, size = "medium" } = Astro.props;
---

<section class:list={["page-hero", `page-hero--${size}`]} data-tone="dark">
  <div class="page-hero__media">
    <img src={image.src} alt={image.alt} width="2048" height="1365" fetchpriority="high" decoding="async" data-parallax="-0.1" />
  </div>
  <div class="container page-hero__content">
    <h1 class="display display-xl">
      <span data-load style="--load-delay: 0.15s">{title.lead}</span>
      <span class="accent" data-load style="--load-delay: 0.3s">{title.accent}</span>
    </h1>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 780px;
    padding: 160px 0 64px;
    overflow: hidden;
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .page-hero--tall {
    min-height: max(100svh, 760px);
  }

  .page-hero__media {
    position: absolute;
    inset: -6% 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(42 29 20 / 0.45), transparent 30%),
      linear-gradient(0deg, rgb(42 29 20 / 0.7), transparent 55%);
    pointer-events: none;
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  @media (max-width: 809px) {
    .page-hero {
      min-height: 620px;
      padding-bottom: 40px;
    }

    .page-hero__content {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
