---
import { HOME, THERMAL_CIRCUIT } from "@/data/content";

/** "El mediodía es para el agua": foto del óculo a sangre, titular centrado y cinco tarjetas de vidrio. */
const { thermal } = HOME;
---

<section class="thermal" data-tone="dark">
  <div class="thermal__media" aria-hidden="true">
    <img src={thermal.image.src} alt="" width="2048" height="1152" loading="lazy" decoding="async" data-parallax="0.08" />
  </div>
  <div class="thermal__shade" aria-hidden="true"></div>
  <span class="visually-hidden">{thermal.image.alt}</span>
  <div class="container thermal__content">
    <div class="thermal__copy">
      <h2 class="display display-xl display--inline" data-reveal>
        <span>{thermal.title.lead}</span> <span class="accent">{thermal.title.accent}</span>
      </h2>
      <p class="lede" data-reveal style="--reveal-delay: 0.1s">{thermal.text}</p>
    </div>
    <ul class="thermal__circuit">
      {
        THERMAL_CIRCUIT.map((item, index) => (
          <li class="thermal__card" data-reveal style={`--reveal-delay: ${0.1 + index * 0.08}s`}>
            <p class="thermal__value">{item.value}</p>
            <p class="thermal__label">{item.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .thermal {
    position: relative;
    min-height: max(100vh, 760px);
    padding: 110px 0 190px;
    overflow: hidden;
    background: var(--color-umber);
    color: var(--color-on-dark);
  }

  .thermal__media {
    position: absolute;
    inset: -8% 0;
  }

  .thermal__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thermal__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(42 29 20 / 0.45), rgb(42 29 20 / 0.1) 45%, rgb(42 29 20 / 0.45));
  }

  .thermal__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 120px;
    min-height: calc(max(100vh, 760px) - 300px);
  }

  .thermal__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .thermal__copy h2 {
    max-width: 1100px;
  }

  .thermal__copy .lede {
    max-width: 460px;
  }

  .thermal__circuit {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  .thermal__card {
    width: 200px;
    padding: 22px 21px 26px;
    border: 1px solid rgb(245 237 225 / 0.2);
    border-radius: 20px;
    background: linear-gradient(180deg, rgb(42 29 20 / 0.35), rgb(42 29 20 / 0.15));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .thermal__value {
    margin-bottom: 26px;
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1.1;
  }

  .thermal__label {
    font-size: 14px;
    color: rgb(245 237 225 / 0.85);
  }

  @media (max-width: 1100px) {
    .thermal__circuit {
      flex-wrap: wrap;
    }

    .thermal__card {
      width: calc((100% - 24px) / 3);
    }
  }

  @media (max-width: 809px) {
    .thermal {
      padding: 110px 0 80px;
    }

    .thermal__content {
      gap: 64px;
    }

    .thermal__card {
      width: calc((100% - 12px) / 2);
    }
  }
</style>
