---
import Icon from "@/components/Icon.astro";
import SplitHeading from "@/components/SplitHeading.astro";
import SuiteCard from "@/components/SuiteCard.astro";
import { HOME } from "@/data/content";
import { getSuite } from "@/data/lookup";

/** "Habitaciones que guardan la sombra": tres suites en arco, la central desplazada hacia abajo. */
const { suites } = HOME;
const featured = suites.featured.map(getSuite);
---

<section class="suites-preview" data-tone="light">
  <div class="container">
    <div class="suites-preview__header">
      <SplitHeading title={suites.title} size="l" />
      <div class="suites-preview__aside" data-reveal>
        <p class="lede">{suites.text}</p>
        <a class="link-arrow" href={suites.link.href}>
          {suites.link.label}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
    <ul class="suites-preview__cards">
      {
        featured.map((suite, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 0.12}s`}>
            <SuiteCard suite={suite} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .suites-preview {
    padding: 120px 0 150px;
  }

  .suites-preview__header {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 110px;
  }

  .suites-preview__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
    max-width: 400px;
    padding-top: 30px;
  }

  .suites-preview__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px;
  }

  .suites-preview__cards > li:nth-child(2) {
    padding-top: 150px;
  }

  @media (max-width: 809px) {
    .suites-preview {
      padding: 100px 0;
    }

    .suites-preview__header {
      flex-direction: column;
      margin-bottom: 56px;
    }

    .suites-preview__aside {
      gap: 28px;
      padding-top: 0;
    }

    .suites-preview__cards {
      display: flex;
      gap: 16px;
      margin: 0 calc(var(--gutter) * -1);
      padding: 0 var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .suites-preview__cards > li {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }

    .suites-preview__cards > li:nth-child(2) {
      padding-top: 0;
    }
  }
</style>
