---
import Icon from "@/components/Icon.astro";
import { HOME } from "@/data/content";

/** "Al anochecer, el cielo es el techo": foto nocturna redondeada con parallax y tres tarjetas. */
const { afterDark } = HOME;
---

<section class="after-dark" data-tone="dark">
  <div class="container">
    <div class="after-dark__sky">
      <div class="after-dark__media" aria-hidden="true">
        <img src={afterDark.image.src} alt="" width="2048" height="1152" loading="lazy" decoding="async" data-parallax="0.1" />
      </div>
      <span class="visually-hidden">{afterDark.image.alt}</span>
      <h2 class="display display-l after-dark__title" data-reveal>
        <span>{afterDark.title.lead}</span>
        <span class="accent">{afterDark.title.accent}</span>
      </h2>
    </div>
    <ul class="after-dark__features">
      {
        afterDark.features.map((feature, index) => (
          <li class="night-card" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
            <div class="media night-card__media">
              <img src={feature.image.src} alt={feature.image.alt} width="409" height="300" loading="lazy" decoding="async" />
            </div>
            <div class="night-card__copy">
              <div class="chip-row">
                {feature.chips.map((chip) => (
                  <span class="chip chip--glow">
                    <Icon name={chip.icon} />
                    {chip.label}
                  </span>
                ))}
              </div>
              <h3 class="night-card__title">{feature.title}</h3>
              <p class="night-card__text">{feature.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .after-dark {
    padding: 120px 0 150px;
    background: linear-gradient(180deg, var(--color-plum) 0%, var(--color-night) 160px);
    color: var(--color-cream);
  }

  .after-dark__sky {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 820px;
    padding: 0 40px 70px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #0d0a0d;
  }

  .after-dark__media {
    position: absolute;
    inset: -10% 0;
  }

  .after-dark__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .after-dark__sky::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgb(17 13 12 / 0.75) 100%);
  }

  .after-dark__title {
    position: relative;
    z-index: 1;
    text-align: center;
    color: var(--color-cream);
  }

  .after-dark__features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 80px;
  }

  .night-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 14px 14px 30px;
    border: 1px solid rgb(243 231 214 / 0.08);
    border-radius: 26px;
    background: rgb(243 231 214 / 0.04);
  }

  .night-card__media {
    aspect-ratio: 409 / 300;
    border-radius: var(--radius-sm);
  }

  .night-card__copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 10px;
  }

  .night-card__title {
    font-family: var(--font-display);
    font-size: clamp(30px, 2.5vw, 36px);
    font-weight: 400;
    line-height: 1.15;
  }

  .night-card__text {
    font-size: 15px;
    line-height: 1.5;
    color: rgb(243 231 214 / 0.7);
  }

  @media (max-width: 999px) {
    .after-dark__features {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 809px) {
    .after-dark {
      padding: 100px 0;
    }

    .after-dark__sky {
      min-height: 520px;
      padding: 0 20px 40px;
    }

    .after-dark__features {
      margin-top: 40px;
    }
  }
</style>
