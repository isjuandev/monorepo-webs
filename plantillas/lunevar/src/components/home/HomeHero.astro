---
import Icon from "@/components/Icon.astro";
import { PLAN_HREF } from "@/config/site";
import { HOME, SUN, UI_LABELS } from "@/data/content";
import { arcPath } from "@/lib/sun";

/**
 * Hero "Vive al ritmo de la luz": foto a sangre con sombras superior e izquierda, titular en dos
 * líneas, dial solar en vivo (hora del visitante entre amanecer y atardecer) y barra de estancia.
 * El texto entra al cargar con fundido escalonado.
 */
const { hero } = HOME;
---

<section class="hero" data-tone="dark">
  <div class="hero__media" aria-hidden="true">
    <img
      src={hero.image.src}
      alt=""
      width="2048"
      height="1143"
      fetchpriority="high"
      decoding="async"
      data-parallax="-0.12"
    />
  </div>
  <div class="hero__shade hero__shade--top" aria-hidden="true"></div>
  <div class="hero__shade hero__shade--left" aria-hidden="true"></div>
  <span class="visually-hidden">{hero.image.alt}</span>

  <div class="container hero__content">
    <div class="hero__copy">
      <h1 class="display display-xl hero__title">
        <span data-load style="--load-delay: 0.15s">{hero.title.lead}</span>
        <span class="accent" data-load style="--load-delay: 0.3s">{hero.title.accent}</span>
      </h1>
      <p class="lede hero__text" data-load style="--load-delay: 0.5s">{hero.text}</p>
    </div>

    <div class="hero__side">
      <div class="hero-dial" data-live-dial data-sunrise={SUN.sunrise} data-sunset={SUN.sunset} data-load style="--load-delay: 0.6s">
        <svg viewBox="0 0 300 152" data-cx="150" data-cy="150" data-r="130" aria-hidden="true">
          <path d={arcPath(150, 150, 130)} class="hero-dial__track"></path>
          <path d={arcPath(150, 150, 130)} class="hero-dial__fill" pathLength="1" data-dial-fill></path>
          <line x1="0" y1="150.5" x2="300" y2="150.5" class="hero-dial__horizon"></line>
          <circle r="7" cx="20" cy="150" class="hero-dial__sun" data-dial-sun></circle>
        </svg>
        <p class="hero-dial__label">{UI_LABELS.sunrise}<br />{SUN.sunrise}</p>
        <p class="hero-dial__label hero-dial__label--end">{UI_LABELS.sunset}<br />{SUN.sunset}</p>
      </div>

      <div class="stay-bar" data-load style="--load-delay: 0.75s">
        {
          hero.planner.fields.map((field, index) => (
            <div class:list={["stay-bar__field", { "stay-bar__field--wide": index > 1 }]}>
              <p class="stay-bar__label">{field.label}</p>
              <p class="stay-bar__value" data-default-arrive={index === 0 ? SUN.defaultLeadDays : undefined}>
                {field.value || UI_LABELS.chooseDate}
              </p>
            </div>
          ))
        }
        <a class="btn btn--accent stay-bar__cta" href={PLAN_HREF}>
          <span class="stay-bar__cta-long">{hero.planner.cta}</span>
          <span class="stay-bar__cta-short">{hero.planner.ctaShort}</span>
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { LOCALE } from "@/lib/format";

  // Fecha de llegada sugerida: hoy + días de antelación (la misma que usa el planificador).
  const format = new Intl.DateTimeFormat(LOCALE, { weekday: "short", day: "numeric", month: "short" });
  for (const el of document.querySelectorAll<HTMLElement>("[data-default-arrive]")) {
    const date = new Date();
    date.setDate(date.getDate() + Number(el.dataset.defaultArrive));
    const text = format.format(date);
    el.textContent = text.charAt(0).toUpperCase() + text.slice(1);
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(100svh, 720px);
    padding: 140px 0 64px;
    overflow: hidden;
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .hero__media {
    position: absolute;
    inset: -6% 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 50%;
    animation: hero-zoom 2.4s var(--ease-out) both;
  }

  .hero__shade {
    position: absolute;
    pointer-events: none;
  }

  .hero__shade--top {
    inset: 0 0 auto;
    height: 300px;
    background: linear-gradient(180deg, rgb(42 29 20 / 0.55), transparent);
  }

  .hero__shade--left {
    inset: 0 auto 0 0;
    width: 62%;
    background: linear-gradient(90deg, rgb(42 29 20 / 0.62), rgb(42 29 20 / 0.25) 55%, transparent);
  }

  .hero__content {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }

  .hero__copy {
    max-width: 440px;
  }

  .hero__title {
    margin-bottom: 48px;
    white-space: nowrap;
  }

  .hero__text {
    max-width: 400px;
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 56px;
    width: min(760px, 56%);
  }

  .hero-dial {
    position: relative;
    width: 300px;
    padding-bottom: 36px;
  }

  .hero-dial svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero-dial__track,
  .hero-dial__fill {
    fill: none;
    stroke: var(--color-on-dark);
    stroke-width: 1.2;
  }

  .hero-dial__track {
    stroke-opacity: 0.3;
  }

  :global(.is-night) > svg .hero-dial__track {
    stroke-opacity: 0.6;
    stroke-dasharray: 2 4;
  }

  .hero-dial__fill {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-opacity: 0.9;
  }

  .hero-dial__horizon {
    stroke: var(--color-on-dark);
    stroke-opacity: 0.35;
  }

  .hero-dial__sun {
    fill: rgb(245 237 225 / 0.55);
    stroke: rgb(245 237 225 / 0.8);
  }

  .hero-dial__label {
    position: absolute;
    bottom: 0;
    left: 0;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-on-dark-muted);
  }

  .hero-dial__label--end {
    left: auto;
    right: 0;
    text-align: right;
  }

  .stay-bar {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 72px;
    padding: 10px 10px 10px 28px;
    border: 1px solid rgb(245 237 225 / 0.22);
    border-radius: var(--radius-pill);
    background: rgb(245 237 225 / 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .stay-bar__field {
    flex: 1 1 auto;
    min-width: 0;
    padding-right: 18px;
  }

  .stay-bar__field + .stay-bar__field {
    padding-left: 18px;
    border-left: 1px solid rgb(245 237 225 / 0.22);
  }

  .stay-bar__label {
    font-size: 11px;
    color: rgb(245 237 225 / 0.6);
  }

  .stay-bar__value {
    margin-top: 4px;
    font-size: 16px;
    white-space: nowrap;
  }

  .stay-bar__cta {
    flex: none;
  }

  .stay-bar__cta-short {
    display: none;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
    }
  }

  @media (max-width: 1100px) {
    .stay-bar__field--wide {
      display: none;
    }
  }

  @media (max-width: 809px) {
    .hero {
      padding: 120px 0 24px;
    }

    .hero__shade--left {
      width: 100%;
      background: linear-gradient(180deg, transparent 15%, rgb(42 29 20 / 0.55) 45%, rgb(42 29 20 / 0.2));
    }

    .hero__content {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }

    .hero__title {
      margin-bottom: 20px;
      white-space: normal;
    }

    .hero__side {
      width: 100%;
      align-items: stretch;
      gap: 28px;
    }

    .hero-dial {
      width: 100%;
    }

    .stay-bar {
      padding-left: 18px;
    }

    .stay-bar__cta {
      padding: 0 18px;
    }

    .stay-bar__cta-long,
    .stay-bar__cta :global(svg) {
      display: none;
    }

    .stay-bar__cta-short {
      display: inline;
    }
  }
</style>
