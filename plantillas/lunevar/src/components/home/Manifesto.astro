---
import { HOME } from "@/data/content";
import { formatNumber } from "@/lib/format";

/**
 * Manifiesto "Creamos … para las horas intermedias": declaración de 85 px con fotos en píldora
 * intercaladas; cada palabra pasa de borrosa a nítida al avanzar el scroll (scripts/motion.ts).
 * Debajo, cuatro cifras que cuentan desde cero al entrar en vista.
 */
const { manifesto } = HOME;
---

<section class="manifesto" data-tone="light">
  <div class="container">
    <p class="manifesto__statement" data-words>
      {
        manifesto.lines.map((line) => (
          <span class="manifesto__line">
            {line.map((part) =>
              part.image ? (
                <span class="manifesto__pill" data-word>
                  <img src={part.image.src} alt={part.image.alt} width="150" height="78" loading="lazy" decoding="async" />
                </span>
              ) : (
                (part.text ?? "").split(" ").map((word) => (
                  <span class:list={["manifesto__word", { accent: part.accent }]} data-word>
                    {word}
                  </span>
                ))
              )
            )}
          </span>
        ))
      }
    </p>
    <dl class="manifesto__stats">
      {
        manifesto.stats.map((stat) => (
          <div class="manifesto__stat">
            <dt class="manifesto__label">{stat.label}</dt>
            <dd class="manifesto__value" data-count={stat.value} data-suffix={stat.suffix}>
              {formatNumber(stat.value)}
              {stat.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .manifesto {
    padding: 150px 0;
    background: var(--color-sand);
  }

  .manifesto__statement {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    max-width: 1240px;
    margin: 0 auto 96px;
    font-family: var(--font-display);
    font-size: clamp(36px, 5.9vw, 85px);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .manifesto__line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 0.26em;
  }

  .manifesto__word {
    display: inline-block;
    transition:
      opacity 0.2s linear,
      filter 0.2s linear;
  }

  .manifesto__pill {
    display: inline-block;
    width: 1.76em;
    height: 0.92em;
    margin: 0 0.1em;
    overflow: hidden;
    border-radius: var(--radius-pill);
  }

  .manifesto__pill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .manifesto__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-line);
  }

  .manifesto__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 14px;
    padding: 28px 28px 0 0;
  }

  .manifesto__value {
    font-family: var(--font-display);
    font-size: clamp(44px, 4.5vw, 65px);
    font-weight: 300;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .manifesto__label {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (max-width: 809px) {
    .manifesto {
      padding: 100px 0;
    }

    .manifesto__statement {
      display: block;
      margin-bottom: 64px;
    }

    .manifesto__line {
      display: inline;
    }

    .manifesto__line::after {
      content: " ";
    }

    .manifesto__word,
    .manifesto__pill {
      margin-right: 0.22em;
    }

    .manifesto__pill {
      vertical-align: -0.1em;
    }

    .manifesto__stats {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }

    .manifesto__value {
      font-size: 40px;
    }
  }
</style>
