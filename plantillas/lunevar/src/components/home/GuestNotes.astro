---
import Icon from "@/components/Icon.astro";
import { GUEST_NOTES, HOME, PRESS, UI_LABELS } from "@/data/content";

/**
 * Notas de huéspedes: cinco citas que se funden cada 5,5 s (pausa al pasar el puntero o con foco),
 * con guiones para saltar a cada una. Debajo, la fila de prensa.
 */
---

<section class="guests" data-tone="dark">
  <div class="container">
    <div class="guests__notes" data-notes aria-roledescription="carousel" aria-label={UI_LABELS.guestNotesLabel}>
      <div class="guests__stage">
        {
          GUEST_NOTES.map((note, index) => (
            <figure class:list={["note", { "is-active": index === 0 }]} data-note aria-hidden={index === 0 ? undefined : "true"}>
              <blockquote class="note__quote">
                {note.quote[0]}
                <em>{note.quote[1]}</em>
                {note.quote[2]}
              </blockquote>
              <figcaption class="note__guest">
                <img src={note.avatar.src} alt={note.avatar.alt} width="64" height="64" loading="lazy" decoding="async" />
                <div>
                  <p class="note__name">{note.name}</p>
                  <div class="chip-row">
                    <span class="chip chip--dark">{note.program}</span>
                    <span class="chip chip--dark">
                      <Icon name="moon" />
                      {note.stay}
                    </span>
                  </div>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="guests__dots">
        {
          GUEST_NOTES.map((_, index) => (
            <button
              type="button"
              class="guests__dot"
              aria-label={UI_LABELS.showNote(index + 1)}
              aria-pressed={index === 0 ? "true" : "false"}
              data-note-dot={index}
            />
          ))
        }
      </div>
    </div>

    <div class="press">
      <p class="press__label">{HOME.press.label}</p>
      <ul class="press__logos">
        {PRESS.map((logo) => <li class:list={["press-logo", `press-logo--${logo.style}`]}>{logo.name}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  const INTERVAL = 5500;
  for (const root of document.querySelectorAll<HTMLElement>("[data-notes]")) {
    const notes = [...root.querySelectorAll<HTMLElement>("[data-note]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-note-dot]")];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let timer = 0;

    const show = (index: number) => {
      current = (index + notes.length) % notes.length;
      notes.forEach((note, i) => {
        note.classList.toggle("is-active", i === current);
        if (i === current) note.removeAttribute("aria-hidden");
        else note.setAttribute("aria-hidden", "true");
      });
      dots.forEach((dot, i) => {
        dot.setAttribute("aria-pressed", String(i === current));
      });
    };

    const start = () => {
      window.clearInterval(timer);
      if (!reduce.matches) timer = window.setInterval(() => show(current + 1), INTERVAL);
    };
    const stop = () => window.clearInterval(timer);

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        show(i);
        start();
      });
    });
    root.addEventListener("pointerenter", stop);
    root.addEventListener("pointerleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    start();
  }
</script>

<style>
  .guests {
    padding: 140px 0;
    background: var(--color-night);
    color: var(--color-cream);
  }

  .guests__notes {
    max-width: 1100px;
    margin: 0 auto 64px;
  }

  .guests__stage {
    display: grid;
  }

  .note {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1s var(--ease-out),
      visibility 0s linear 1s;
  }

  .note.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 1s var(--ease-out),
      visibility 0s;
  }

  .note__quote {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.25vw, 61px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
  }

  .note__quote em {
    color: var(--color-glow);
  }

  .note__guest {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .note__guest img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .note__name {
    margin-bottom: 8px;
    font-size: 15px;
  }

  .guests__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 56px;
  }

  .guests__dot {
    width: 12px;
    height: 12px;
    background: linear-gradient(currentColor, currentColor) center / 100% 2px no-repeat;
    color: rgb(243 231 214 / 0.35);
    transition:
      width 0.4s var(--ease-out),
      color 0.4s var(--ease-out);
  }

  .guests__dot[aria-pressed="true"] {
    width: 28px;
    color: var(--color-cream);
  }

  .press {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-top: 36px;
    border-top: 1px solid rgb(243 231 214 / 0.12);
  }

  .press__label {
    flex: none;
    font-size: 11px;
    color: rgb(243 231 214 / 0.5);
  }

  .press__logos {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding-left: 70px;
  }

  @media (max-width: 809px) {
    .guests {
      padding: 100px 0;
    }

    .press {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .press__logos {
      justify-content: flex-start;
      padding-left: 0;
    }
  }
</style>
