---
import Icon from "@/components/Icon.astro";
import SunClock from "@/components/SunClock.astro";
import { MENU_LINKS, PLAN_HREF, siteConfig } from "@/config/site";
import { UI_LABELS } from "@/data/content";

export interface Props {
  /** Tono inicial: "dark" = texto claro sobre un primer bloque oscuro */
  tone?: "light" | "dark";
}

/**
 * Cabecera fija de la fuente: transparente, se oculta al bajar y reaparece al subir. El color del
 * texto se adapta al bloque que tiene debajo (secciones con `data-tone="dark"`). En mobile, el menú
 * es una capa oscura a pantalla completa con la "hora" de cada sección.
 */
const { tone = "light" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-tone={tone} data-initial-tone={tone} data-menu="closed">
  <div class="site-header__bar">
    <a class="site-header__logo" href="/" aria-label={`${siteConfig.name} — ${UI_LABELS.homeLink}`}>
      {siteConfig.logoText}
    </a>
    <nav class="site-header__nav" aria-label={UI_LABELS.mainNav}>
      <ul>
        {
          MENU_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-header__link"
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__right">
      <SunClock />
      <a class="site-header__cta" href={PLAN_HREF}>{UI_LABELS.planStay}</a>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={UI_LABELS.openMenu}
        data-label-open={UI_LABELS.openMenu}
        data-label-close={UI_LABELS.closeMenu}
        data-menu-toggle
      >
        <Icon name="menu" size={22} class="site-header__icon-menu" />
        <Icon name="close" size={20} class="site-header__icon-close" />
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul class="mobile-menu__links">
      {
        MENU_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-menu__link"
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              <span class="mobile-menu__time">{link.time}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <svg class="mobile-menu__arc" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M -40 120 Q 200 -40 440 120" fill="none" stroke="currentColor" stroke-dasharray="3 5"
      ></path>
    </svg>
    <a class="btn btn--accent mobile-menu__cta" href={PLAN_HREF}>
      {UI_LABELS.planStay}
      <Icon name="arrow-right" />
    </a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = header?.querySelector<HTMLElement>("#mobile-menu");

  function setOpen(open: boolean): void {
    if (!header || !toggle || !menu) return;
    header.dataset.menu = open ? "open" : "closed";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "");
    menu.hidden = !open;
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) menu.querySelector<HTMLElement>("a")?.focus();
  }

  toggle?.addEventListener("click", () => setOpen(header?.dataset.menu !== "open"));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header?.dataset.menu === "open") {
      setOpen(false);
      toggle?.focus();
    }
  });
  window.matchMedia("(min-width: 1000px)").addEventListener("change", (event) => {
    if (event.matches && header?.dataset.menu === "open") setOpen(false);
  });

  // Se oculta al bajar, reaparece al subir; el tono sigue al bloque que queda debajo.
  let lastY = window.scrollY;
  let ticking = false;
  const PROBE_Y = 50;

  function toneAt(y: number): string {
    for (const section of document.querySelectorAll<HTMLElement>("[data-tone]")) {
      if (section === header) continue;
      const rect = section.getBoundingClientRect();
      if (rect.top <= y && rect.bottom > y) return section.dataset.tone ?? "light";
    }
    return "light";
  }

  function update(): void {
    ticking = false;
    if (!header || header.dataset.menu === "open") return;
    const y = window.scrollY;
    const delta = y - lastY;
    if (y < 120 || delta < -4) header.classList.remove("is-hidden");
    else if (delta > 4) header.classList.add("is-hidden");
    header.classList.toggle("is-scrolled", y > 20);
    header.dataset.tone = y < 20 ? (header.dataset.initialTone ?? "light") : toneAt(PROBE_Y);
    lastY = y;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true }
  );
  update();
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    color: var(--color-text);
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.6s var(--ease-out),
      color 0.4s var(--ease-out);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
    opacity: 0;
  }

  .site-header[data-tone="dark"] {
    color: var(--color-on-dark);
  }

  .site-header__bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 100px;
    padding: 28px var(--gutter);
  }

  .site-header__logo {
    justify-self: start;
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .site-header__nav ul {
    display: flex;
    gap: 34px;
  }

  .site-header__link {
    position: relative;
    display: block;
    padding: 10px 2px;
    font-size: 14px;
    line-height: 1.2;
    transition: color 0.3s var(--ease-out);
  }

  .site-header__link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .site-header__link:hover,
  .site-header__link[aria-current="page"] {
    color: var(--color-accent);
  }

  .site-header__link:hover::after,
  .site-header__link[aria-current="page"]::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .site-header__right {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 12px;
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-dark);
    font-size: 15px;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  [data-tone="dark"] .site-header__cta {
    background: var(--color-on-dark);
    color: var(--color-primary);
  }

  .site-header__toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-on-dark);
    color: var(--color-primary);
  }

  [data-tone="light"] .site-header__toggle {
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .site-header__toggle :global(.site-header__icon-close),
  [data-menu="open"] .site-header__toggle :global(.site-header__icon-menu) {
    display: none;
  }

  [data-menu="open"] .site-header__toggle :global(.site-header__icon-close) {
    display: block;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 999px) {
    .site-header__bar {
      grid-template-columns: 1fr auto;
      min-height: 76px;
      padding: 16px var(--gutter);
    }

    .site-header__logo {
      font-size: 21px;
    }

    .site-header__nav,
    .site-header__cta {
      display: none;
    }

    .site-header__toggle {
      display: grid;
    }

    [data-menu="open"] {
      color: var(--color-on-dark);
    }

    [data-menu="open"] .site-header__toggle {
      background: var(--color-on-dark);
      color: var(--color-primary);
    }

    .mobile-menu:not([hidden]) {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      padding: 120px var(--gutter) 24px;
      overflow-y: auto;
      background: var(--color-primary);
      color: var(--color-on-dark);
      animation: menu-in 0.45s var(--ease-out);
    }

    .mobile-menu__links {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .mobile-menu__link {
      display: flex;
      align-items: baseline;
      gap: 18px;
      font-family: var(--font-display);
      font-size: 40px;
      line-height: 1.3;
    }

    .mobile-menu__link[aria-current="page"] {
      color: var(--color-glow);
    }

    .mobile-menu__time {
      width: 26px;
      flex: none;
      font-family: var(--font-sans);
      font-size: 11px;
      color: var(--color-glow);
    }

    .mobile-menu__arc {
      width: calc(100% + var(--gutter) * 2);
      height: 110px;
      margin: auto calc(var(--gutter) * -1) 0;
      color: rgb(245 237 225 / 0.35);
    }

    .mobile-menu__cta {
      margin-top: 24px;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
</style>
