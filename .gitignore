# Dependencies & Lockfiles (pnpm only)
node_modules/
.pnpm-store/
package-lock.json
yarn.lock
bun.lockb

# Build & Test outputs
dist/
.astro/
.turbo/
build/
playwright-report/
test-results/
# Salidas de QA de cada sitio (capturas current-*.png e informes)
plantillas/*/docs/qa/
clientes/*/docs/qa/
# Estado y logs locales de pnpm cliente:crear / plantilla:clonar
.pipeline/

# Recursos manuales por cliente (se versionan README, _plantilla-cliente y el ejemplo la-guaca).
# La bandeja entrada/ y el trabajo del intake (.intake/) nunca se suben, ni en la rama del cliente.
recursos/*
!recursos/README.md
!recursos/_plantilla-cliente/
!recursos/_plantilla-cliente/**
!recursos/la-guaca/
!recursos/la-guaca/**

# Environment variables
.env
.env.*
!.env.example

# macOS / OS
.DS_Store
Thumbs.db

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
