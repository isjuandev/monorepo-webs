{
  "name": "monorepo-webs",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para múltiples sitios web de clientes con Astro, Preact, pnpm workspaces y Turborepo",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "turbo run check",
    "verify": "pnpm verify:isolation && pnpm lint && pnpm check && pnpm build",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "new-client-site": "node scripts/new-client-site.mjs",
    "test:visual": "playwright test && node scripts/visual-qa-summary.mjs",
    "test:visual:update": "UPDATE_SNAPSHOTS=true playwright test --update-snapshots && node scripts/visual-qa-summary.mjs",
    "clean": "turbo run clean && rm -rf node_modules playwright-report test-results"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
