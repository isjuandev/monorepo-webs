---
import ReviewCards from "@/components/ReviewCards.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { galleryPhotos } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Gallery — Aurelia Resort"
  description="Immerse yourself in the visual elegance of Aurelia Resort: panoramic Mediterranean suites, private infinity pools, dining terraces, and tranquil moments."
>
  <SiteHeader currentPath="/gallery" theme="solid" />

  <main>
    <!-- =========================================================================
         Page Hero
         ========================================================================= -->
    <section class="gallery-page-hero">
      <div class="container text-center reveal">
        <span class="badge-overline">GALLERY</span>
        <h1 class="heading-display gallery-hero-title">A Glimpse of Aurelia</h1>
        <p class="gallery-hero-subtitle">
          Mediterranean elegance, timeless architecture and unforgettable ocean views
          come together to create an experience unlike any other.
        </p>
      </div>
    </section>

    <!-- =========================================================================
         Full Gallery Grid
         ========================================================================= -->
    <section class="gallery-full-section">
      <div class="container">
        <div class="gallery-masonry-grid">
          {
            galleryPhotos.map((photo, idx) => {
              // Alternate aspect ratios and spans for organic luxury aesthetic
              const isFeature = idx === 0 || idx === 6 || idx === 11;
              return (
                <div
                  class={`gallery-item ${isFeature ? "item-featured" : ""} reveal reveal-delay-${(idx % 3) + 1}`}
                >
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    class="gallery-image"
                    loading="lazy"
                  />
                  <div class="gallery-caption-overlay">
                    <p class="gallery-caption-text">{photo.alt}</p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Testimonios -->
    <ReviewCards />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .gallery-page-hero {
    background-color: var(--color-primary);
    color: #ffffff;
    padding-top: clamp(4.5rem, 8vw, 6.5rem);
    padding-bottom: clamp(4rem, 7vw, 5.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .text-center {
    text-align: center;
  }

  .gallery-hero-title {
    font-size: clamp(2.75rem, 5.5vw, 4.75rem);
    margin-bottom: 1.25rem;
  }

  .gallery-hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.65;
    max-width: 660px;
    margin-left: auto;
    margin-right: auto;
    color: rgba(255, 255, 255, 0.85);
  }

  .gallery-full-section {
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
    background-color: var(--color-cream);
  }

  .gallery-masonry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .gallery-masonry-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-masonry-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .item-featured {
      grid-column: span 2;
    }
  }

  .gallery-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: var(--color-sand);
    box-shadow: 0 8px 24px rgba(30, 42, 36, 0.05);
  }

  .item-featured {
    aspect-ratio: 16 / 10;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.05);
  }

  .gallery-caption-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(30, 42, 36, 0.75) 0%,
      rgba(30, 42, 36, 0) 50%
    );
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .gallery-item:hover .gallery-caption-overlay {
    opacity: 1;
  }

  .gallery-caption-text {
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
  }
</style>
