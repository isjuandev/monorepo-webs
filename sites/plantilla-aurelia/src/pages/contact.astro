---
import CtaBanner from "@/components/CtaBanner.astro";
import FaqSection from "@/components/FaqSection.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Get in Touch — Aurelia Resort"
  description="Contact Aurelia Resort in Ibiza. Our dedicated concierge team is delighted to assist with reservations, inquiries, and custom itineraries."
>
  <SiteHeader currentPath="/contact" theme="solid" />

  <main>
    <!-- =========================================================================
         Page Hero
         ========================================================================= -->
    <section class="contact-page-hero">
      <div class="container text-center reveal">
        <span class="badge-overline">CONTACT</span>
        <h1 class="heading-display contact-hero-title">Get in Touch</h1>
        <p class="contact-hero-subtitle">
          Whether you're planning your next getaway, celebrating a special occasion or
          simply have a question, our team is here to help. We'd love to hear from you.
        </p>
      </div>
    </section>

    <!-- =========================================================================
         Form & Location Grid
         ========================================================================= -->
    <section class="contact-content-section">
      <div class="container contact-grid">
        <!-- Columna Formulario -->
        <div class="contact-form-wrap reveal">
          <h2 class="heading-card form-heading">Send us a message</h2>
          <form class="contact-main-form" action="#" method="POST">
            <div class="form-group">
              <label for="contact-name">Name</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="Your full name"
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-email">Email</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="your@email.com"
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-subject">Subject</label>
              <input
                type="text"
                id="contact-subject"
                name="subject"
                placeholder="How can we assist you?"
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-message">Message</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                placeholder="Tell us about your plans, questions, or requested dates..."
                required></textarea>
            </div>

            <button type="submit" class="btn btn-dark w-full">Send message</button>
          </form>
        </div>

        <!-- Columna Ubicación & Detalles -->
        <div class="contact-info-wrap reveal reveal-delay-1">
          <span class="badge-overline">OUR LOCATION</span>
          <h2 class="heading-section location-title">Aurelia Resort</h2>
          <p class="location-desc">
            Set in a peaceful corner of Ibiza, Aurelia Resort invites you to experience
            timeless elegance, warm Mediterranean hospitality and unforgettable moments by
            the sea.
          </p>

          <div class="direct-contact-items">
            <div class="contact-row">
              <span class="row-label">Phone</span>
              <a href="tel:+34971123456" class="row-value">+34 971 123 456</a>
            </div>

            <div class="contact-row">
              <span class="row-label">Email</span>
              <a href="mailto:hello@aureliaresort.com" class="row-value">
                hello@aureliaresort.com
              </a>
            </div>

            <div class="contact-row">
              <span class="row-label">Address</span>
              <p class="row-value">
                Carrer Punta Blanca 5 <br />
                07849 Santa Eulària des Riu <br />
                Ibiza, Spain
              </p>
            </div>
          </div>

          <!-- Mapa Visual -->
          <div class="map-card-frame">
            <iframe
              title="Aurelia Resort Ibiza Location Map"
              src="https://maps.google.com/maps?q=Santa+Eulalia+del+Rio,+Ibiza,+Spain&t=&z=13&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="260"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- Banner CTA -->
    <CtaBanner />

    <!-- FAQ -->
    <FaqSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .contact-page-hero {
    background-color: var(--color-primary);
    color: #ffffff;
    padding-top: clamp(4.5rem, 8vw, 6.5rem);
    padding-bottom: clamp(4rem, 7vw, 5.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .text-center {
    text-align: center;
  }

  .contact-hero-title {
    font-size: clamp(2.75rem, 5.5vw, 4.75rem);
    margin-bottom: 1.25rem;
  }

  .contact-hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.65;
    max-width: 660px;
    margin-left: auto;
    margin-right: auto;
    color: rgba(255, 255, 255, 0.85);
  }

  .contact-content-section {
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
    background-color: #ffffff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 5rem;
      align-items: start;
    }
  }

  /* Form */
  .contact-form-wrap {
    background-color: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(2rem, 4vw, 3rem);
    box-shadow: 0 4px 24px rgba(30, 42, 36, 0.04);
  }

  .form-heading {
    font-size: 1.75rem;
    color: var(--color-primary);
    margin-bottom: 1.75rem;
  }

  .contact-main-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: #ffffff;
    font-size: 0.9375rem;
    color: var(--color-text);
    transition: border-color var(--transition-fast);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .w-full {
    width: 100%;
    margin-top: 0.5rem;
  }

  /* Location Info */
  .contact-info-wrap {
    display: flex;
    flex-direction: column;
  }

  .location-title {
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .location-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .direct-contact-items {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .contact-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .row-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .row-value {
    font-size: 1.0625rem;
    color: var(--color-primary);
    font-weight: 500;
    line-height: 1.5;
  }

  .row-value:hover {
    color: var(--color-accent);
  }

  .map-card-frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 16px rgba(30, 42, 36, 0.06);
  }
</style>
