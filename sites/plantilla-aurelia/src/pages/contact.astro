---
import CtaBanner from "@/components/CtaBanner.astro";
import FaqSection from "@/components/FaqSection.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Get in Touch"
  description="Contact Aurelia Resort in Ibiza. Our dedicated concierge team is delighted to assist with reservations, inquiries, and custom itineraries."
>
  <SiteHeader currentPath="/contact" theme="transparent" />

  <main>
    <!-- =========================================================================
         Hero con Imagen Aérea de Fondo y Tarjeta de Contacto Oscura
         ========================================================================= -->
    <section class="contact-hero-section">
      <div class="contact-hero-bg">
        <img
          src="/images/rPGiZzoWjPb5uwEqVyk2DYpHU.jpg"
          alt=""
          class="hero-bg-img"
          width="1440"
          height="900"
        />
        <div class="hero-bg-overlay"></div>
      </div>

      <div class="container contact-hero-container">
        <!-- Tarjeta Flotante Oscura -->
        <div class="contact-card-dark reveal">
          <span class="badge-overline text-accent">— CONTACT —</span>
          <h1 class="contact-card-title">Get in Touch</h1>
          <p class="contact-card-subtitle">
            Whether you're planning your next getaway, celebrating a special occasion or
            simply have a question, our team is here to help. We'd love to hear from you.
          </p>

          <form class="contact-form" action="#" method="POST">
            <div class="form-group">
              <label for="contact-name">Name</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="Your name"
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-email">Email</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="Your email"
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-subject">Subject</label>
              <input
                type="text"
                id="contact-subject"
                name="subject"
                placeholder="The subject"
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-message">Message</label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                placeholder="Your message..."
                required></textarea>
            </div>

            <button type="submit" class="btn btn-tan w-full">Send message</button>
          </form>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         Sección Our Location
         ========================================================================= -->
    <section class="contact-location-section">
      <div class="contact-location-bg">
        <img
          src="/images/B9TgZKFojhZcITmuAoyhovIoabg.jpg"
          alt=""
          class="location-bg-img"
          width="1440"
          height="755"
        />
        <div class="location-bg-overlay"></div>
      </div>
      <div class="container contact-location-inner reveal">
        <span class="badge-overline">— OUR LOCATION —</span>
        <h2 class="heading-section location-title">Aurelia Resort</h2>
        <p class="location-desc">
          Set in a peaceful corner of Ibiza, Aurelia Resort invites you to experience
          timeless elegance, warm Mediterranean hospitality and unforgettable moments by
          the sea.
        </p>

        <div class="location-links-list">
          <a href="tel:+34971123456" class="location-link-item">
            <svg class="loc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>+34 971 123 456</span>
          </a>

          <a href="mailto:hello@aureliaresort.com" class="location-link-item">
            <svg class="loc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>hello@aureliaresort.com</span>
          </a>

          <div class="location-link-item">
            <svg class="loc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Carrer Punta Blanca 5 07849 Santa Eulària des Riu Ibiza, Spain</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Banner CTA -->
    <CtaBanner />

    <!-- FAQ -->
    <FaqSection btnText="Our Rooms" btnHref="/rooms" />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .contact-hero-section {
    position: relative;
    padding-top: clamp(6.5rem, 11vw, 9rem);
    padding-bottom: clamp(5rem, 8vw, 7.5rem);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 90vh;
  }

  .contact-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 19, 0.4);
  }

  .contact-hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  .contact-card-dark {
    background-color: rgba(27, 39, 32, 0.94);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: clamp(2rem, 4vw, 3.25rem);
    max-width: 560px;
    width: 100%;
    color: #ffffff;
    text-align: center;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
  }

  .text-accent {
    color: var(--color-accent);
  }

  .contact-card-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.15;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .contact-card-subtitle {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    text-align: left;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem 0.875rem;
    background-color: #24332b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    font-size: 0.875rem;
    color: #ffffff;
    transition: border-color var(--transition-fast);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .w-full {
    width: 100%;
    margin-top: 0.75rem;
    padding: 0.875rem;
    border-radius: 6px;
  }

  /* Location Section */
  .contact-location-section {
    position: relative;
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    overflow: hidden;
  }

  .contact-location-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .location-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .location-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(248, 245, 240, 0.95) 0%,
      rgba(248, 245, 240, 0.88) 55%,
      rgba(248, 245, 240, 0.5) 100%
    );
  }

  .contact-location-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin-left: 0;
  }

  .location-title {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .location-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .location-links-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .location-link-item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-primary);
    transition: color 0.2s;
  }

  .location-link-item:hover {
    color: var(--color-accent);
  }

  .loc-icon {
    width: 18px;
    height: 18px;
    stroke: var(--color-accent);
    flex-shrink: 0;
  }
</style>
