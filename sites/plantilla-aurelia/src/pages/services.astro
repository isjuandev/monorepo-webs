---
import FaqSection from "@/components/FaqSection.astro";
import ReviewCards from "@/components/ReviewCards.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { allServices } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Our Services"
  description="Discover curated Mediterranean culinary journeys, private yacht experiences, and holistic wellness rituals at Aurelia Resort, Ibiza."
>
  <!-- =========================================================================
       Hero con Foto de Fondo a Pantalla Completa
       ========================================================================= -->
  <section class="services-hero-section">
    <div class="services-hero-bg">
      <img
        src="/images/aEzPtSmyulvvzrKdrPYZwF9X5R8.png"
        alt="Aurelia Resort entrance and hospitality"
        class="services-hero-img animate-ken-burns"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div class="services-hero-overlay"></div>
    </div>

    <SiteHeader currentPath="/services" theme="transparent" />

    <div class="container services-hero-inner">
      <div class="services-hero-text">
        <span class="hero-badge animate-badge">&#9734; WELCOME TO AURELIA &#9734;</span>
        <h1 class="heading-display services-hero-title animate-title">
          Where Luxury <br />
          Feels Natural
        </h1>
        <p class="services-hero-subtitle animate-sub">
          Nestled along the breathtaking coastline of Ibiza, Aurelia Resort offers a
          refined escape where contemporary elegance, exceptional hospitality and the
          beauty of nature come together to create unforgettable moments.
        </p>
      </div>
    </div>
  </section>

  <main>
    <!-- =========================================================================
         Intro Section ("Where Moments Become Memories")
         ========================================================================= -->
    <section class="services-intro-section">
      <div class="services-intro-bg">
        <img
          src="/images/B9TgZKFojhZcITmuAoyhovIoabg.jpg"
          alt=""
          class="intro-bg-img"
          width="1440"
          height="592"
        />
        <div class="intro-bg-overlay"></div>
      </div>
      <div class="container services-intro-grid reveal">
        <div class="intro-left">
          <span class="badge-overline">— INSPIRED BY THE ISLAND —</span>
          <h2 class="heading-section intro-heading">
            Where Moments <br />
            Become Memories
          </h2>
        </div>
        <div class="intro-right">
          <p class="intro-body">
            At Aurelia Resort, luxury is defined by simplicity, authenticity and genuine
            hospitality. Every detail has been thoughtfully designed to create a peaceful
            sanctuary where guests can reconnect with nature while enjoying world-class
            comfort.
          </p>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         3 Extended Service Showcases (Fondo Verde Bosque con Fotos en Arco)
         ========================================================================= -->
    <section class="services-showcase-section">
      <div class="container services-showcase-list">
        {
          allServices.map((svc, idx) => {
            const isReversed = idx % 2 === 1;
            return (
              <article
                class={`service-showcase-row ${isReversed ? "row-reverse" : ""} reveal`}
              >
                <!-- Columna de Foto en Arco Cápsula -->
                <div class="service-arch-outer">
                  <div class="service-arch-frame">
                    <img
                      src={svc.imageMain.src}
                      alt={svc.imageMain.alt}
                      class="service-arch-img"
                      loading="lazy"
                    />
                  </div>
                </div>

                <!-- Columna de Texto -->
                <div class="service-info-col">
                  <div class="service-icon-circle">
                    <img
                      src={svc.icon}
                      alt=""
                      class="service-svg"
                      width="26"
                      height="26"
                    />
                  </div>
                  <h4 class="service-row-title">{svc.title}</h4>
                  <span class="service-badge-overline">{svc.badge}</span>
                  <p class="service-row-desc">{svc.description}</p>

                  <div class="service-row-hours">
                    {svc.hours.split("\n").map((line) => (
                      <p class="hours-line">{line}</p>
                    ))}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- Testimonial Hero Twilight -->
    <ReviewCards />

    <!-- FAQ -->
    <FaqSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* =========================================================================
     Hero Styles
     ========================================================================= */
  .services-hero-section {
    position: relative;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #ffffff;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .services-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .services-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .services-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 28, 24, 0.4) 0%,
      rgba(15, 22, 18, 0.75) 100%
    );
  }

  .services-hero-inner {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 4rem;
  }

  .services-hero-text {
    max-width: 680px;
  }

  .hero-badge {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    display: inline-block;
    margin-bottom: 1rem;
  }

  .services-hero-title {
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 1.08;
    margin-bottom: 1.25rem;
  }

  .services-hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
  }

  /* =========================================================================
     Intro Section
     ========================================================================= */
  .services-intro-section {
    position: relative;
    padding-top: clamp(5rem, 9vw, 8rem);
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    overflow: hidden;
  }

  .services-intro-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .intro-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(248, 245, 240, 0.95) 0%,
      rgba(248, 245, 240, 0.88) 55%,
      rgba(248, 245, 240, 0.5) 100%
    );
  }

  .services-intro-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .services-intro-grid {
      grid-template-columns: 1.1fr 1.3fr;
      gap: 4.5rem;
    }
  }

  .intro-heading {
    margin-top: 0.5rem;
    color: var(--color-primary);
  }

  .intro-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  /* =========================================================================
     Showcase Section (Dark Forest Green)
     ========================================================================= */
  .services-showcase-section {
    background-color: var(--color-primary);
    color: #ffffff;
    padding-top: clamp(5.5rem, 10vw, 9rem);
    padding-bottom: clamp(5.5rem, 10vw, 9rem);
  }

  .services-showcase-list {
    display: flex;
    flex-direction: column;
    gap: clamp(5rem, 10vw, 9rem);
  }

  .service-showcase-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .service-showcase-row {
      grid-template-columns: 1fr 1.2fr;
      gap: 6rem;
    }

    .service-showcase-row.row-reverse {
      grid-template-columns: 1.2fr 1fr;
    }

    .service-showcase-row.row-reverse .service-arch-outer {
      order: 2;
    }

    .service-showcase-row.row-reverse .service-info-col {
      order: 1;
    }
  }

  /* Arch Frame */
  .service-arch-outer {
    position: relative;
    max-width: 420px;
    width: 100%;
    margin: 0 auto;
    padding: 10px;
    border: 1px solid rgba(191, 158, 101, 0.35);
    border-radius: 999px;
  }

  .service-arch-frame {
    border-radius: 999px;
    overflow: hidden;
    aspect-ratio: 0.68;
    background-color: var(--color-sand);
  }

  .service-arch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .service-arch-img:hover {
    transform: scale(1.03);
  }

  /* Info Column */
  .service-info-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .service-icon-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(191, 158, 101, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .service-svg {
    filter: invert(72%) sepia(25%) saturate(750%) hue-rotate(355deg) brightness(90%) contrast(90%);
  }

  .service-row-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .service-badge-overline {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .service-row-desc {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.8);
    max-width: 520px;
    margin-bottom: 2rem;
  }

  .service-row-hours {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hours-line {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(191, 158, 101, 0.9);
  }
</style>
