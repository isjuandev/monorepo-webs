---
import CtaBanner from "@/components/CtaBanner.astro";
import FaqSection from "@/components/FaqSection.astro";
import ReviewCards from "@/components/ReviewCards.astro";
import RoomCard from "@/components/RoomCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { type Room, allRooms, hotelAmenities } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return allRooms.map((room) => ({
    params: { slug: room.slug },
    props: { room },
  }));
}

export interface Props {
  room: Room;
}

const { room } = Astro.props;
const otherRooms = [allRooms[5], allRooms[4], allRooms[3]];
---

<BaseLayout
  title={`${room.name} - Aurelia`}
  description={room.summary}
  ogImage={room.image.src}
>
  <SiteHeader currentPath={`/rooms/${room.slug}`} theme="transparent" />

  <main>
    <!-- =========================================================================
         Hero de Habitación con Foto a Pantalla Completa
         ========================================================================= -->
    <section class="room-hero">
      <div class="room-hero-bg">
        <img
          src={room.image.src}
          alt={room.name}
          class="room-hero-img animate-ken-burns"
          width="1440"
          height="700"
        />
        <div class="room-hero-overlay"></div>
      </div>

      <div class="container room-hero-content">
        <h1 class="room-hero-title animate-title">{room.name}</h1>
        <p class="room-hero-summary animate-sub">{room.summary}</p>
      </div>
    </section>

    <!-- =========================================================================
         Sección About Room & Galería de 3 Fotos
         ========================================================================= -->
    <section class="room-about-section">
      <div class="container">
        <div class="room-about-header reveal">
          <div class="about-titles-col">
            <h2 class="badge-overline">— ABOUT —</h2>
            <h2 class="heading-section about-room-title">About {room.name}</h2>
            <div class="specs-pills">
              <div class="pill-item">
                <img src="/icons/spec-size.svg" alt="" width="16" height="16" />
                <span class="pill-value">{room.size}</span>
              </div>
              <div class="pill-item">
                <img src="/icons/spec-bed.svg" alt="" width="16" height="16" />
                <span class="pill-value">{room.bed}</span>
              </div>
              <div class="pill-item">
                <img src="/icons/spec-guests.svg" alt="" width="16" height="16" />
                <span class="pill-value">{room.guests}</span>
              </div>
            </div>
          </div>
          <div class="about-price-pill">
            <span>From {room.price}</span>
          </div>
        </div>

        <!-- Galería Curada de 3 Fotos -->
        <div class="room-gallery-grid reveal">
          <div class="gal-left-large">
            <img
              src={room.gallery[0]?.src || room.image.src}
              alt={room.gallery[0]?.alt || room.name}
              class="room-photo"
            />
          </div>
          <div class="gal-right-stack">
            <div class="gal-sub">
              <img
                src={room.gallery[1]?.src || room.image.src}
                alt={room.gallery[1]?.alt || room.name}
                class="room-photo"
              />
            </div>
            <div class="gal-sub">
              <img
                src={room.gallery[2]?.src || room.image.src}
                alt={room.gallery[2]?.alt || room.name}
                class="room-photo"
              />
            </div>
          </div>
        </div>

        <!-- Textos Descriptivos de la Habitación -->
        <div class="room-long-desc reveal">
          <p>{room.description}</p>
          {room.extendedDescription && <p>{room.extendedDescription}</p>}
        </div>
      </div>
    </section>

    <!-- =========================================================================
         Hotel Amenities (Cuadrícula 4x2)
         ========================================================================= -->
    <section class="hotel-amenities-section">
      <div class="container reveal">
        <h3 class="amenities-heading">Hotel Amenities</h3>
        <div class="amenities-grid">
          {
            hotelAmenities.map((amenity) => (
              <div class="amenity-card">
                <div class="amenity-icon-box">
                  <img
                    src={amenity.icon}
                    alt=""
                    class="amenity-svg"
                    width="22"
                    height="22"
                  />
                </div>
                <span class="amenity-text">{amenity.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Banner CTA -->
    <CtaBanner />

    <!-- =========================================================================
         Other Rooms
         ========================================================================= -->
    <section class="other-rooms-section">
      <div class="container">
        <div class="other-rooms-header reveal">
          <div>
            <span class="badge-overline">— LUXURY SUITES & VILLAS —</span>
            <h2 class="heading-section">Other Rooms</h2>
            <p class="section-desc-compact">
              Discover a collection of beautifully designed suites and private villas, each
              offering breathtaking views for an unforgettable stay.
            </p>
          </div>
          <a href="/rooms" class="rooms-all-link">
            <span>All Rooms</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="other-rooms-grid">
          {
            otherRooms.map((r, idx) => (
              <div class={`reveal reveal-delay-${idx + 1}`}>
                <RoomCard room={r} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Testimonial Hero Twilight -->
    <ReviewCards />

    <!-- FAQ -->
    <FaqSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* Room Hero */
  .room-hero {
    position: relative;
    min-height: clamp(480px, 60vh, 680px);
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(3.5rem, 6vw, 5rem);
    color: #ffffff;
    overflow: hidden;
  }

  .room-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .room-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .room-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 22, 18, 0.25) 0%,
      rgba(15, 22, 18, 0.75) 100%
    );
  }

  .room-hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .room-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .room-hero-summary {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
  }

  /* About Room Section */
  .room-about-section {
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    background-color: var(--color-cream);
  }

  .room-about-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2.5rem;
    gap: 2rem;
  }

  .about-room-title {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .about-price-pill {
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  .specs-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .pill-item {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.4rem 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* 3-Photo Gallery Grid */
  .room-gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 840px) {
    .room-gallery-grid {
      grid-template-columns: 1.8fr 1fr;
      gap: 1.5rem;
    }
  }

  .gal-left-large {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 16 / 11;
  }

  .gal-right-stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 840px) {
    .gal-right-stack {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .gal-sub {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .room-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .room-photo:hover {
    transform: scale(1.025);
  }

  .room-long-desc {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 900px;
  }

  /* Hotel Amenities */
  .hotel-amenities-section {
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
    background-color: #ffffff;
  }

  .amenities-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 500;
    margin-bottom: 2.5rem;
    color: var(--color-primary);
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 840px) {
    .amenities-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .amenity-card {
    background-color: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .amenity-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .amenity-svg {
    filter: invert(72%) sepia(25%) saturate(750%) hue-rotate(355deg) brightness(90%) contrast(90%);
  }

  .amenity-text {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Other Rooms Section */
  .other-rooms-section {
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    background-color: var(--color-cream);
  }

  .other-rooms-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    gap: 2rem;
  }

  .section-desc-compact {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin-top: 0.75rem;
  }

  .rooms-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transition: gap 0.2s;
  }

  .rooms-all-link:hover {
    gap: 0.65rem;
  }

  .other-rooms-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .other-rooms-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>
