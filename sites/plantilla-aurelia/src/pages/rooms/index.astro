---
import FaqSection from "@/components/FaqSection.astro";
import ReviewCards from "@/components/ReviewCards.astro";
import RoomCard from "@/components/RoomCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { allRooms } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Our Rooms — Aurelia Resort"
  description="Discover our collection of beautifully designed luxury suites and private villas in Ibiza, each offering breathtaking Mediterranean views."
>
  <SiteHeader currentPath="/rooms" theme="solid" />

  <main>
    <!-- Header de Página -->
    <section class="rooms-page-hero">
      <div class="container text-center reveal">
        <span class="badge-overline">LUXURY SUITES & VILLAS</span>
        <h1 class="heading-display rooms-page-title">Our Rooms</h1>
        <p class="rooms-page-subtitle">
          Discover a collection of beautifully designed suites and private villas, each
          offering breathtaking views for an unforgettable stay.
        </p>
      </div>
    </section>

    <!-- Cuadrícula con las 6 Habitaciones -->
    <section class="rooms-grid-section">
      <div class="container">
        <div class="rooms-full-grid">
          {
            allRooms.map((room, idx) => (
              <div class={`reveal reveal-delay-${(idx % 3) + 1}`}>
                <RoomCard room={room} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Testimonios -->
    <ReviewCards />

    <!-- FAQ -->
    <FaqSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .rooms-page-hero {
    background-color: var(--color-primary);
    color: #ffffff;
    padding-top: clamp(4.5rem, 8vw, 6.5rem);
    padding-bottom: clamp(4rem, 7vw, 5.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .text-center {
    text-align: center;
  }

  .rooms-page-title {
    font-size: clamp(2.75rem, 5.5vw, 4.5rem);
    margin-bottom: 1.25rem;
  }

  .rooms-page-subtitle {
    font-size: 1.125rem;
    line-height: 1.65;
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
    color: rgba(255, 255, 255, 0.85);
  }

  .rooms-grid-section {
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
    background-color: var(--color-cream);
  }

  .rooms-full-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 768px) {
    .rooms-full-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .rooms-full-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
