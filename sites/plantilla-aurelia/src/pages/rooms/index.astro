---
import FaqSection from "@/components/FaqSection.astro";
import ReviewCards from "@/components/ReviewCards.astro";
import RoomCard from "@/components/RoomCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { allRooms } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Our Rooms"
  description="Discover a collection of beautifully designed suites and private villas, each offering breathtaking views for an unforgettable stay."
>
  <SiteHeader currentPath="/rooms" theme="solid" />

  <main>
    <!-- Sección de Habitaciones con Fondo F69ommdMTt9Aqp4dz821ZCCc9Zg.jpg y Overlay Sand -->
    <section class="rooms-page-wrapper">
      <div class="rooms-page-bg">
        <img
          src="/images/F69ommdMTt9Aqp4dz821ZCCc9Zg.jpg"
          alt=""
          class="rooms-bg-img"
          width="1440"
          height="1800"
        />
        <div class="rooms-bg-overlay"></div>
      </div>

      <div class="rooms-page-content">
        <!-- Header de Página -->
        <header class="rooms-page-hero">
          <div class="container text-center reveal">
            <span class="badge-overline">— LUXURY SUITES & VILLAS —</span>
            <h1 class="heading-display rooms-page-title">Our Rooms</h1>
            <p class="rooms-page-subtitle">
              Discover a collection of beautifully designed suites and private villas, each
              offering breathtaking views for an unforgettable stay.
            </p>
          </div>
        </header>

        <!-- Cuadrícula con las 6 Habitaciones -->
        <div class="container rooms-grid-container">
          <div class="rooms-full-grid">
            {
              allRooms.map((room, idx) => (
                <div class={`reveal reveal-delay-${(idx % 3) + 1}`}>
                  <RoomCard room={room} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonial Hero -->
    <ReviewCards />

    <!-- FAQ -->
    <FaqSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .rooms-page-wrapper {
    position: relative;
    overflow: hidden;
  }

  .rooms-page-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .rooms-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rooms-bg-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(238, 231, 221, 0.75);
  }

  .rooms-page-content {
    position: relative;
    z-index: 1;
    padding-top: clamp(4.5rem, 8vw, 6.5rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .text-center {
    text-align: center;
  }

  .rooms-page-title {
    font-size: clamp(2.75rem, 5.5vw, 4.5rem);
    color: #222222;
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .rooms-page-subtitle {
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 4rem;
    color: var(--color-text-muted);
  }

  .rooms-full-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 768px) {
    .rooms-full-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .rooms-full-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
