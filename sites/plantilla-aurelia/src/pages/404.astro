---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found — Aurelia Resort"
  description="The requested page could not be found."
  noindex
>
  <SiteHeader currentPath="/404" theme="solid" />

  <main class="page-404-main">
    <div class="container text-center reveal">
      <span class="badge-overline">404 ERROR</span>
      <h1 class="heading-display error-title">Page Not Found</h1>
      <p class="error-desc">
        The page you are looking for might have been removed, had its name changed,
        or is temporarily unavailable.
      </p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Return to Home</a>
        <a href="/rooms" class="btn btn-outline-dark">Explore Our Rooms</a>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .page-404-main {
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: clamp(4rem, 8vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    background-color: var(--color-cream);
  }

  .text-center {
    text-align: center;
  }

  .error-title {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .error-desc {
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    color: var(--color-text-muted);
    margin-bottom: 2.25rem;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
