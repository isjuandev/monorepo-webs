---
export interface Props {
  text?: string;
  btnText?: string;
  btnHref?: string;
}

const {
  text = "Luxury stays, unforgettable moments, and the true spirit of Ibiza.",
  btnText = "Book Now",
  btnHref = "/rooms",
} = Astro.props;
---

<section class="cta-banner">
  <div class="container text-center reveal">
    <h4 class="cta-text">{text}</h4>
    <a href={btnHref} class="cta-link">
      <span>{btnText}</span>
      <span class="cta-arrow">&rarr;</span>
    </a>
  </div>
</section>

<style>
  .cta-banner {
    background-color: var(--color-primary);
    color: #ffffff;
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
    text-align: center;
  }

  .cta-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-weight: 500;
    line-height: 1.3;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    color: rgba(238, 231, 221, 0.95);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: opacity 0.25s ease, gap 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-link:hover {
    opacity: 0.85;
    gap: 0.75rem;
  }

  .cta-arrow {
    font-size: 1.1rem;
    line-height: 1;
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-link:hover .cta-arrow {
    transform: translateX(4px);
  }
</style>
