---
import type { Room } from "@/data/content";

export interface Props {
  room: Room;
}

const { room } = Astro.props;
---

<article class="room-card">
  <div class="card-image-wrap">
    <img
      src={room.image.src}
      alt={room.image.alt}
      class="card-img"
      loading="lazy"
      width="400"
      height="260"
    />
    <div class="card-price-badge">
      <span class="price-prefix">From</span>
      <span class="price-amount">{room.price}</span>
    </div>
  </div>

  <div class="card-body">
    <h5 class="card-title">
      <a href={`/rooms/${room.slug}`}>{room.name}</a>
    </h5>

    <!-- Especificaciones con iconos SVG -->
    <div class="card-specs">
      <div class="spec-item">
        <img src="/icons/spec-size.svg" alt="" class="spec-icon" width="16" height="16" />
        <span>{room.size}</span>
      </div>
      <div class="spec-item">
        <img src="/icons/spec-bed.svg" alt="" class="spec-icon" width="16" height="16" />
        <span>{room.bed}</span>
      </div>
      <div class="spec-item">
        <img src="/icons/spec-guests.svg" alt="" class="spec-icon" width="16" height="16" />
        <span>{room.guests}</span>
      </div>
    </div>

    <p class="card-summary">{room.summary}</p>

    <div class="card-action">
      <a href={`/rooms/${room.slug}`} class="btn-card-explore">Explore Room</a>
    </div>
  </div>
</article>

<style>
  .room-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .room-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(30, 42, 36, 0.08);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-sand);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .room-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-price-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(30, 42, 36, 0.85);
    backdrop-filter: blur(6px);
    color: #ffffff;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .price-prefix {
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
  }

  .price-amount {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
    margin-bottom: 0.875rem;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem;
    padding-bottom: 1.125rem;
    margin-bottom: 1.125rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .spec-icon {
    width: 15px;
    height: 15px;
    opacity: 0.75;
  }

  .card-summary {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .card-action {
    margin-top: auto;
  }

  .btn-card-explore {
    display: block;
    width: 100%;
    text-align: center;
    background-color: #5c6e64;
    color: #ffffff;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: background-color var(--transition-fast);
  }

  .btn-card-explore:hover {
    background-color: var(--color-primary);
    color: #ffffff;
  }
</style>
