---
import { navLinks } from "@/data/content";
---

<footer class="site-footer">
  <div class="footer-bg-wrapper">
    <img
      src="/images/oWJA0iz6yvn8OvIhxFQ2UQRM.jpg"
      alt="Aurelia Resort ocean landscape"
      class="footer-bg-img"
      loading="lazy"
    />
    <div class="footer-overlay"></div>
  </div>

  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Columna Marca & Ubicación -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo" aria-label="Aurelia Resort Home">
          <img src="/icons/logo.svg" alt="Aurelia Resort" width="180" height="36" />
        </a>
        <p class="footer-tagline">
          Luxury stays, unforgettable moments, and the true spirit of Ibiza.
        </p>
        <div class="footer-address">
          <p class="address-title">Aurelia Resort Ibiza</p>
          <p>Carrer Punta Blanca 5</p>
          <p>07849 Santa Eulària des Riu</p>
          <p>Ibiza, Spain</p>
        </div>
      </div>

      <!-- Columna Contacto -->
      <div class="footer-col">
        <p class="footer-heading">Contact</p>
        <ul class="footer-links">
          <li>
            <a href="https://aureliaresort.com" target="_blank" rel="noopener noreferrer">
              www.aureliaresort.com
            </a>
          </li>
          <li>
            <a href="mailto:hello@aureliaresort.com">hello@aureliaresort.com</a>
          </li>
          <li>
            <a href="tel:+34971123456">+34 971 123 456</a>
          </li>
        </ul>
      </div>

      <!-- Columna Páginas -->
      <div class="footer-col">
        <p class="footer-heading">Pages</p>
        <ul class="footer-links">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna Redes Sociales -->
      <div class="footer-col">
        <p class="footer-heading">Social</p>
        <ul class="footer-links">
          <li>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">
              Instagram
            </a>
          </li>
          <li>
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer">
              Facebook
            </a>
          </li>
          <li>
            <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer">
              TikTok
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright Inferior -->
    <div class="footer-bottom">
      <p class="creator-credit">Created by Slashdown</p>
      <p class="copyright">© All rights reserved</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: var(--color-primary);
    color: #ffffff;
    overflow: hidden;
    padding-top: 5rem;
    padding-bottom: 2.5rem;
  }

  .footer-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .footer-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .footer-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-primary) 0%,
      rgba(30, 42, 36, 0.9) 50%,
      var(--color-primary-dark) 100%
    );
  }

  .footer-content {
    position: relative;
    z-index: 2;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .footer-logo img {
    height: 36px;
    width: auto;
    filter: brightness(0) invert(1);
    margin-bottom: 1.25rem;
  }

  .footer-tagline {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 320px;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .footer-address {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  .address-title {
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-links a {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.75);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
    }
  }
</style>
