---
import { navLinks } from "@/data/content";

export interface Props {
  currentPath?: string;
  theme?: "transparent" | "solid";
}

const { currentPath = Astro.url.pathname, theme = "transparent" } = Astro.props;
---

<header class={`site-header ${theme === "solid" ? "header-solid" : ""}`}>
  <!-- Barra de navegación principal -->
  <div class="main-nav-bar">
    <div class="container nav-inner">
      <a href="/" class="brand-logo" aria-label="Aurelia Resort Home">
        <img src="/icons/logo.svg" alt="Aurelia Resort" width="160" height="32" />
      </a>

      <!-- Menú desktop -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {
            navLinks.map((link) => {
              const isActive =
                link.href === "/"
                  ? currentPath === "/"
                  : currentPath.startsWith(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    class={`nav-link ${isActive ? "is-active" : ""}`}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <!-- Meta info desktop: Ubicación & Teléfono -->
      <div class="nav-meta-desktop">
        <div class="meta-item">
          <svg
            class="meta-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Ibiza, Spain</span>
        </div>
        <a href="tel:+34971123456" class="meta-item meta-phone">
          <svg
            class="meta-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
          <span>+34 971 123 456</span>
        </a>
      </div>

      <!-- Botón hamburguesa móvil -->
      <button
        type="button"
        class="hamburger-btn"
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="bar bar-top"></span>
        <span class="bar bar-mid"></span>
        <span class="bar bar-bot"></span>
      </button>
    </div>
  </div>

  <!-- Menú lateral móvil -->
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop"></div>
    <div class="mobile-drawer-content">
      <div class="mobile-drawer-header">
        <a href="/" class="brand-logo">
          <img src="/icons/logo.svg" alt="Aurelia Resort" width="140" height="28" />
        </a>
        <button
          type="button"
          class="drawer-close-btn"
          id="mobile-menu-close"
          aria-label="Close menu"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-nav-links">
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="mobile-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mobile-drawer-footer">
        <a href="/contact" class="btn btn-primary w-full">Book Now</a>
        <div class="drawer-contact-info">
          <p class="drawer-phone">+34 971 123 456</p>
          <p class="drawer-address">Carrer Punta Blanca 5, Ibiza</p>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const backdrop = document.getElementById("mobile-drawer-backdrop");
  const drawer = document.getElementById("mobile-nav-drawer");

  function openMenu() {
    drawer?.classList.add("is-open");
    toggleBtn?.classList.add("is-active");
    toggleBtn?.setAttribute("aria-expanded", "true");
    drawer?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    drawer?.classList.remove("is-open");
    toggleBtn?.classList.remove("is-active");
    toggleBtn?.setAttribute("aria-expanded", "false");
    drawer?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  toggleBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer?.classList.contains("is-open")) {
      closeMenu();
    }
  });
</script>

<style>
  .site-header {
    position: relative;
    width: 100%;
    z-index: 50;
    color: #ffffff;
  }

  .header-solid {
    background-color: var(--color-primary);
  }

  /* Main Nav Bar */
  .main-nav-bar {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    display: flex;
    align-items: center;
  }

  .brand-logo img {
    height: 32px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 2.25rem;
    align-items: center;
  }

  .nav-link {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    position: relative;
    padding-bottom: 0.25rem;
    display: inline-block;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: #ffffff;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: #ffffff;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Desktop Meta Info */
  .nav-meta-desktop {
    display: none;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (min-width: 1024px) {
    .nav-meta-desktop {
      display: flex;
    }
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-phone {
    color: rgba(255, 255, 255, 0.85);
    transition: color 0.2s;
  }

  .meta-phone:hover {
    color: #ffffff;
  }

  .meta-icon {
    width: 15px;
    height: 15px;
    stroke: var(--color-accent);
  }

  /* Hamburger animado 1:1 Framer */
  .hamburger-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    color: #ffffff;
    position: relative;
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .hamburger-btn {
      display: none;
    }
  }

  .hamburger-btn .bar {
    width: 22px;
    height: 1.5px;
    background-color: #ffffff;
    border-radius: 4px;
    position: absolute;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  .hamburger-btn .bar-top {
    transform: translateY(-5px);
  }

  .hamburger-btn .bar-mid {
    transform: translateY(0);
  }

  .hamburger-btn .bar-bot {
    transform: translateY(5px);
  }

  .hamburger-btn.is-active .bar-top {
    transform: translateY(0) rotate(45deg);
  }

  .hamburger-btn.is-active .bar-mid {
    opacity: 0;
    transform: scaleX(0);
  }

  .hamburger-btn.is-active .bar-bot {
    transform: translateY(0) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    visibility: hidden;
    overflow: hidden;
    transition: visibility var(--transition-normal);
  }

  .mobile-drawer.is-open {
    display: block;
    visibility: visible;
  }

  @media (min-width: 900px) {
    .mobile-drawer {
      display: none !important;
    }
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .mobile-drawer.is-open .mobile-drawer-backdrop {
    opacity: 1;
  }

  .mobile-drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(85vw, 360px);
    background-color: var(--color-primary);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(100%);
    transition: transform var(--transition-normal);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.4);
  }

  .mobile-drawer.is-open .mobile-drawer-content {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .drawer-close-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .drawer-close-btn svg {
    width: 24px;
    height: 24px;
  }

  .mobile-nav-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .mobile-link {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #ffffff;
    display: block;
  }

  .mobile-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .w-full {
    width: 100%;
  }

  .drawer-contact-info {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    text-align: center;
  }
</style>
