---
import { allRooms } from "@/data/content";

export interface Props {
  layout?: "horizontal" | "vertical";
  defaultRoom?: string;
}

const { layout = "horizontal", defaultRoom = "" } = Astro.props;
---

<form
  class={`booking-form ${layout === "vertical" ? "form-vertical" : "form-horizontal"}`}
  action="/contact"
  method="GET"
>
  <div class="form-fields">
    <!-- Nombre -->
    <div class="form-group">
      <label for="book-name">Name</label>
      <input
        type="text"
        id="book-name"
        name="name"
        placeholder="Your full name"
        required
      />
    </div>

    <!-- Email -->
    <div class="form-group">
      <label for="book-email">Email</label>
      <input
        type="email"
        id="book-email"
        name="email"
        placeholder="your@email.com"
        required
      />
    </div>

    <!-- Tipo de Habitación -->
    <div class="form-group">
      <label for="book-room">Room Type</label>
      <select id="book-room" name="room">
        <option value="">Select a room...</option>
        {
          allRooms.map((r) => (
            <option value={r.slug} selected={r.slug === defaultRoom}>
              {r.name}
            </option>
          ))
        }
      </select>
    </div>

    <!-- Fechas -->
    <div class="form-row-dates">
      <div class="form-group">
        <label for="book-checkin">Check In</label>
        <input type="date" id="book-checkin" name="checkin" required />
      </div>
      <div class="form-group">
        <label for="book-checkout">Check Out</label>
        <input type="date" id="book-checkout" name="checkout" required />
      </div>
    </div>

    <!-- Huéspedes -->
    <div class="form-row-guests">
      <div class="form-group">
        <label for="book-adults">Adults</label>
        <select id="book-adults" name="adults">
          <option value="1">1</option>
          <option value="2" selected>2</option>
          <option value="3">3</option>
          <option value="4">4</option>
        </select>
      </div>
      <div class="form-group">
        <label for="book-children">Children</label>
        <select id="book-children" name="children">
          <option value="0" selected>0</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
        </select>
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-primary submit-btn">
    Request Booking
  </button>
</form>

<style>
  .booking-form {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
    color: var(--color-primary);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .form-group input,
  .form-group select {
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: #ffffff;
    font-size: 0.875rem;
    color: var(--color-text);
    transition: border-color var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-row-dates,
  .form-row-guests {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  /* Horizontal Layout (Hero) */
  .form-horizontal .form-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .form-horizontal .form-fields {
      grid-template-columns: 1.2fr 1.2fr 1.4fr 1.6fr 1.2fr;
      align-items: flex-end;
      margin-bottom: 1rem;
    }

    .form-horizontal .submit-btn {
      width: 100%;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
  }

  /* Vertical Layout (Sidebar) */
  .form-vertical .form-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .submit-btn {
    width: 100%;
  }
</style>
