---
import { allRooms } from "@/data/content";

export interface Props {
  layout?: "horizontal" | "vertical";
  defaultRoom?: string;
}

const { layout = "horizontal", defaultRoom = "" } = Astro.props;
---

<form
  class={`booking-form ${layout === "vertical" ? "form-vertical" : "form-horizontal"}`}
  action="/contact"
  method="GET"
>
  <div class="form-fields">
    <!-- Nombre -->
    <div class="form-group">
      <label for="book-name">Name</label>
      <input
        type="text"
        id="book-name"
        name="name"
        placeholder="Your Name"
        required
      />
    </div>

    <!-- Email -->
    <div class="form-group">
      <label for="book-email">Email</label>
      <input
        type="email"
        id="book-email"
        name="email"
        placeholder="Your Email"
        required
      />
    </div>

    <!-- Tipo de Habitación -->
    <div class="form-group">
      <label for="book-room">Room Type</label>
      <select id="book-room" name="room">
        <option value="">Select a room...</option>
        {
          allRooms.map((r) => (
            <option value={r.slug} selected={r.slug === defaultRoom}>
              {r.name}
            </option>
          ))
        }
      </select>
    </div>

    <!-- Fechas -->
    <div class="form-row-dates">
      <div class="form-group">
        <label for="book-checkin">Check In</label>
        <input type="date" id="book-checkin" name="checkin" required />
      </div>
      <div class="form-group">
        <label for="book-checkout">Check Out</label>
        <input type="date" id="book-checkout" name="checkout" required />
      </div>
    </div>

    <!-- Huéspedes -->
    <div class="form-row-guests">
      <div class="form-group">
        <label for="book-adults">Adults</label>
        <select id="book-adults" name="adults">
          <option value="1" selected>1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
        </select>
      </div>
      <div class="form-group">
        <label for="book-children">Children</label>
        <select id="book-children" name="children">
          <option value="0" selected>0</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
        </select>
      </div>
    </div>
  </div>

  <button type="submit" class="btn submit-btn">
    Request Booking
  </button>
</form>

<style>
  .booking-form {
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.2);
  }

  /* Formulario Horizontal (Hero) con fondo oscuro de Framer */
  .form-horizontal {
    background-color: rgba(27, 39, 32, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-horizontal .form-group label {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.02em;
  }

  .form-horizontal .form-group input,
  .form-horizontal .form-group select {
    padding: 0.5rem 0.75rem;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    background-color: #24332b;
    font-size: 0.8125rem;
    color: #ffffff;
    transition: border-color var(--transition-fast);
  }

  .form-horizontal .form-group input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-horizontal .form-group input:focus,
  .form-horizontal .form-group select:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-row-dates,
  .form-row-guests {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  /* Horizontal Layout en Desktop: una sola fila */
  .form-horizontal .form-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    margin-bottom: 1rem;
  }

  .form-horizontal .submit-btn {
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-weight: 600;
    border-radius: 6px;
    height: 42px;
    padding: 0 1.25rem;
    width: 100%;
    transition: background-color var(--transition-fast);
  }

  .form-horizontal .submit-btn:hover {
    background-color: #d1b179;
  }

  @media (min-width: 1024px) {
    .form-horizontal {
      display: flex;
      align-items: flex-end;
      gap: 0.75rem;
    }

    .form-horizontal .form-fields {
      display: flex;
      align-items: flex-end;
      gap: 0.75rem;
      flex: 1;
      margin-bottom: 0;
    }

    .form-horizontal .form-group {
      flex: 1;
    }

    .form-horizontal .form-row-dates {
      display: flex;
      gap: 0.5rem;
      flex: 1.7;
    }

    .form-horizontal .form-row-guests {
      display: flex;
      gap: 0.5rem;
      flex: 1.1;
    }

    .form-horizontal .submit-btn {
      width: auto;
      white-space: nowrap;
      margin-bottom: 0;
    }
  }

  /* Formulario Vertical (Sidebar) */
  .form-vertical {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  .form-vertical .form-group label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .form-vertical .form-group input,
  .form-vertical .form-group select {
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: #ffffff;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .form-vertical .form-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .form-vertical .submit-btn {
    background-color: var(--color-primary);
    color: #ffffff;
    width: 100%;
    padding: 0.875rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
</style>
