---
import { reviews } from "@/data/content";
---

<section class="section-testimonial-hero">
  <div class="testimonial-bg-wrap">
    <img
      src="/images/79c9RpRcduZ8DKrbp3PfX5zc7Tc.jpg"
      alt=""
      class="testimonial-bg-img"
      width="1440"
      height="720"
    />
    <div class="testimonial-overlay"></div>
  </div>

  <div class="container testimonial-inner reveal">
    <div class="testimonial-slides" id="testimonial-slides">
      {
        reviews.map((rev, idx) => (
          <div
            class={`testimonial-slide ${idx === 0 ? "active" : ""}`}
            data-slide-index={idx}
          >
            <blockquote class="testimonial-quote">“{rev.quote}”</blockquote>
            <div class="testimonial-stars" aria-label="5 out of 5 stars">
              <span class="star">&#9733;</span>
              <span class="star">&#9733;</span>
              <span class="star">&#9733;</span>
              <span class="star">&#9733;</span>
              <span class="star">&#9733;</span>
            </div>
            <div class="testimonial-author">
              {rev.author} – {rev.source}
            </div>
          </div>
        ))
      }
    </div>

    <div class="testimonial-dots" role="tablist" aria-label="Testimonial slides">
      {
        reviews.map((_, idx) => (
          <button
            type="button"
            class={`dot ${idx === 0 ? "active" : ""}`}
            data-dot-index={idx}
            aria-label={`Go to slide ${idx + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll(".testimonial-slide");
  const dots = document.querySelectorAll(".testimonial-dots .dot");
  let currentIdx = 0;
  let timer: ReturnType<typeof setInterval> | null = null;

  function setSlide(idx: number) {
    currentIdx = idx;
    slides.forEach((s, i) => {
      s.classList.toggle("active", i === idx);
    });
    dots.forEach((d, i) => {
      d.classList.toggle("active", i === idx);
    });
  }

  dots.forEach((dot, idx) => {
    dot.addEventListener("click", () => {
      setSlide(idx);
      resetAuto();
    });
  });

  function startAuto() {
    timer = setInterval(() => {
      setSlide((currentIdx + 1) % slides.length);
    }, 6000);
  }

  function resetAuto() {
    if (timer) clearInterval(timer);
    startAuto();
  }

  startAuto();
</script>

<style>
  .section-testimonial-hero {
    position: relative;
    padding-top: clamp(5rem, 9vw, 8rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
    color: #ffffff;
    text-align: center;
    overflow: hidden;
  }

  .testimonial-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .testimonial-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 28, 24, 0.6) 0%,
      rgba(20, 28, 24, 0.72) 100%
    );
  }

  .testimonial-inner {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .testimonial-slides {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }

  .testimonial-slide {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.98);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.6s ease;
    pointer-events: none;
  }

  .testimonial-slide.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .testimonial-quote {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.75rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.35;
    color: #ffffff;
    margin-bottom: 2rem;
  }

  .testimonial-stars {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    color: var(--color-accent);
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .testimonial-author {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2.5rem;
  }

  .testimonial-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.625rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dot:hover {
    border-color: #ffffff;
    transform: scale(1.2);
  }

  .dot.active {
    background-color: #ffffff;
    border-color: #ffffff;
    transform: scale(1.25);
  }
</style>
