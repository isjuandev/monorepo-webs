---
import { reviews } from "@/data/content";

const currentReview = reviews[0];
---

<section class="section-testimonial-hero">
  <div class="testimonial-bg-wrap">
    <img
      src="/images/79c9RpRcduZ8DKrbp3PfX5zc7Tc.jpg"
      alt=""
      class="testimonial-bg-img"
      width="1440"
      height="720"
    />
    <div class="testimonial-overlay"></div>
  </div>

  <div class="container testimonial-inner reveal">
    <blockquote class="testimonial-quote">
      “{currentReview.quote}”
    </blockquote>

    <div class="testimonial-stars" aria-label="5 out of 5 stars">
      <span class="star">&#9733;</span>
      <span class="star">&#9733;</span>
      <span class="star">&#9733;</span>
      <span class="star">&#9733;</span>
      <span class="star">&#9733;</span>
    </div>

    <div class="testimonial-author">
      {currentReview.author} – {currentReview.source}
    </div>

    <div class="testimonial-dots" aria-hidden="true">
      <span class="dot"></span>
      <span class="dot active"></span>
      <span class="dot"></span>
    </div>
  </div>
</section>

<style>
  .section-testimonial-hero {
    position: relative;
    padding-top: clamp(5rem, 9vw, 8rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
    color: #ffffff;
    text-align: center;
    overflow: hidden;
  }

  .testimonial-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .testimonial-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 28, 24, 0.6) 0%,
      rgba(20, 28, 24, 0.72) 100%
    );
  }

  .testimonial-inner {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .testimonial-quote {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.75rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.35;
    color: #ffffff;
    margin-bottom: 2rem;
  }

  .testimonial-stars {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    color: var(--color-accent);
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .testimonial-author {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2.5rem;
  }

  .testimonial-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.625rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
  }

  .dot.active {
    background-color: #ffffff;
    border-color: #ffffff;
  }
</style>
