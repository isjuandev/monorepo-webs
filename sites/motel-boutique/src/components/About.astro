---
import { MARQUEE_TEXT } from "@/data/content";
---

<section class="about">
  <div class="about__inner">
    <div class="card-white about__card" data-reveal>
      <h2>Una escapada diferente</h2>
      <p>
        Describe aquí la propuesta del lugar: ambiente, aseo, confort y atención. Este texto es
        de ejemplo y debe reemplazarse por el contenido real de cada cliente.
      </p>
      <p>Menciona la ubicación y lo que hace único al establecimiento.</p>
    </div>
  </div>
  <div class="marquee" aria-label={MARQUEE_TEXT}>
    <div class="marquee__track" aria-hidden="true">
      {Array.from({ length: 8 }).map(() => <span>{MARQUEE_TEXT} &nbsp;-&nbsp;</span>)}
    </div>
  </div>
</section>

<style>
  .about { padding: 2rem 0 4rem; }
  .about__inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .about__card { max-width: 420px; }
  .marquee { overflow: hidden; margin-top: 4rem; white-space: nowrap; border-top: 1px solid #262626; border-bottom: 1px solid #262626; padding: 0.9rem 0; }
  .marquee__track { display: inline-flex; animation: marquee 30s linear infinite; font-family: var(--font-display); font-size: 1rem; }
  .marquee__track span { padding-right: 1rem; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }
</style>
