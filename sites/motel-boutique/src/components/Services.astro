---
import { SPECIAL_SERVICES } from "@/data/content";
---

<section id="servicios" class="services">
  <div class="services__inner">
    <h2 class="section-title">Servicios especiales</h2>
    <p class="services__lead">Complementa tu visita con servicios pensados para cada ocasión.</p>
    <div class="services__grid">
      {
        SPECIAL_SERVICES.map((service, index) => (
          <article class="service" data-reveal style={`--reveal-delay: ${index * 120}ms`}>
            <div class="service__img" style={`background: ${service.tone}`} role="img" aria-label={service.title} />
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services { padding: 4rem 0; }
  .services__inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .services .section-title { margin-bottom: 1rem; }
  .services__lead { text-align: center; font-size: 1.2rem; margin-bottom: 3rem; }
  .services__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .service__img { aspect-ratio: 4 / 3; margin-bottom: 1rem; }
  .service h3 { text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.08em; text-align: center; margin-bottom: 0.75rem; }
  .service p { font-size: 0.9rem; color: #d4d4d4; }
  @media (max-width: 860px) { .services__grid { grid-template-columns: 1fr; } }
</style>
