---
import { siteConfig } from "@/config/site";
import { buildWhatsAppUrl } from "@repo/utils";

const whatsapp = siteConfig.contact.whatsapp;
---

<section id="inicio" class="hero">
  <a class="hero__chevron" href="/nuestras-suites" aria-label="Ver suites">
    <svg width="40" height="22" viewBox="0 0 40 22" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M2 2l18 17L38 2" />
    </svg>
  </a>
  <div class="card-white hero__promo">
    <h2>Promoción de temporada</h2>
    <p>Reserva una decoración especial para tu próxima celebración. Servicio de 12 horas disponible todos los días.</p>
    {
      whatsapp && (
        <a class="ui-btn" href={buildWhatsAppUrl(whatsapp, "Hola, quiero información de la promoción")} target="_blank" rel="noopener noreferrer">
          Escríbenos por WhatsApp
        </a>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 2rem;
    background: radial-gradient(ellipse at 30% 30%, #1c0f14 0%, #000 70%);
  }
  .hero__chevron {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    animation: hero-bounce 2s ease-in-out infinite;
  }
  .hero__promo {
    max-width: 380px;
    margin-bottom: -4rem;
    position: relative;
    z-index: 2;
  }
  @keyframes hero-bounce {
    50% { transform: translate(-50%, calc(-50% + 8px)); }
  }
  @media (max-width: 760px) {
    .hero { padding: 1rem; }
    .hero__promo { max-width: none; margin-bottom: -3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__chevron { animation: none; }
  }
</style>
