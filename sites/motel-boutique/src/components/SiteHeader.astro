---
import { MobileMenu } from "@/components/MobileMenu";
import { siteConfig } from "@/config/site";
import { NAV_ITEMS } from "@/data/content";

const { instagram, facebook } = siteConfig.socials ?? {};
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="#inicio" aria-label={siteConfig.name}>
      {siteConfig.name}
    </a>
    <nav class="site-header__nav" aria-label="Principal">
      {NAV_ITEMS.map((item) => <a href={item.href}>{item.label}</a>)}
      <span class="site-header__socials">
        {instagram && <a href={instagram} target="_blank" rel="noopener noreferrer">Instagram</a>}
        {facebook && <a href={facebook} target="_blank" rel="noopener noreferrer">Facebook</a>}
      </span>
    </nav>
    <MobileMenu client:load items={NAV_ITEMS} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-height);
    background: rgb(0 0 0 / 0.92);
    backdrop-filter: blur(6px);
  }
  .site-header__inner {
    height: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-header__brand {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .site-header__nav a {
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transition: color 0.2s ease;
  }
  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--color-accent);
  }
  .site-header__socials {
    display: flex;
    gap: 1rem;
  }
  @media (max-width: 760px) {
    .site-header__inner { padding: 0 1rem; }
    .site-header__nav { display: none; }
  }
</style>
