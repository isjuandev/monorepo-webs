---
import PageHero from "@/components/PageHero.astro";
import { siteConfig } from "@/config/site";
import { MENU } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Restaurante | ${siteConfig.name}`}
  description="Carta del restaurante: desayunos, platos fuertes y bebidas para disfrutar en tu suite."
>
  <PageHero title="Restaurante" subtitle="Disfruta nuestra carta sin salir de la suite." />
  <div class="menu">
    {
      MENU.map((category) => (
        <section>
          <h2>{category.title}</h2>
          <ul>
            {
              category.items.map((item) => (
                <li>
                  <div>
                    <h3>{item.name}</h3>
                    {item.description && <p>{item.description}</p>}
                  </div>
                  <span>{item.price}</span>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .menu { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem 5rem; display: grid; gap: 3rem; }
  .menu h2 { text-transform: uppercase; letter-spacing: 0.08em; font-size: 1.3rem; margin-bottom: 1rem; border-bottom: 1px solid #fff; padding-bottom: 0.5rem; }
  .menu ul { list-style: none; display: grid; gap: 1.2rem; }
  .menu li { display: flex; justify-content: space-between; gap: 1.5rem; }
  .menu h3 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .menu p { color: var(--color-muted); font-size: 0.9rem; }
  .menu span { font-weight: 700; white-space: nowrap; }
</style>
