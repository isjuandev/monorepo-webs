---
import { buildWhatsAppUrl } from "@repo/utils";
import PageHero from "@/components/PageHero.astro";
import { siteConfig } from "@/config/site";
import { STAY_POLICY, SUITES } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const whatsapp = siteConfig.contact.whatsapp;
---

<BaseLayout
  title={`Nuestras suites | ${siteConfig.name}`}
  description="Conoce las categorías de suites, sus tarifas por horas y la política de tiempo de estadía."
>
  <PageHero
    title="Nuestras suites"
    subtitle="Espacios diseñados con la privacidad y el confort en mente. Contamos con 4 categorías."
  />
  <div class="suites-page">
    {
      SUITES.map((suite, index) => (
        <article id={suite.slug} class:list={["detail", { "detail--reverse": index % 2 === 1 }]}>
          <div class="detail__img" style={`background: ${suite.tone}`} role="img" aria-label={`Imagen de ${suite.name}`} />
          <div class="detail__body">
            <h2>{suite.name}</h2>
            <p>{suite.description}</p>
            <dl>
              <div><dt>Tarifa</dt><dd>{suite.price}</dd></div>
              <div><dt>Hora adicional</dt><dd>{suite.extraHour}</dd></div>
              <div><dt>Persona adicional</dt><dd>{suite.extraPerson}</dd></div>
              <div><dt>Servicio de 12 horas</dt><dd>{suite.twelveHours}</dd></div>
            </dl>
            <h3>Características</h3>
            <ul>
              {suite.features.map((feature) => <li>{feature}</li>)}
            </ul>
            {
              whatsapp && (
                <a class="ui-btn" href={buildWhatsAppUrl(whatsapp, `Hola, quiero información de ${suite.name}`)} target="_blank" rel="noopener noreferrer">
                  Reservar
                </a>
              )
            }
          </div>
        </article>
      ))
    }
    <aside class="card-white policy">
      <h2>Política de tiempo de estadía</h2>
      {STAY_POLICY.map((line) => <p>{line}</p>)}
    </aside>
  </div>
</BaseLayout>

<style>
  .suites-page { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 5rem; display: grid; gap: 4rem; }
  .detail { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .detail--reverse .detail__img { order: 2; }
  .detail__img { aspect-ratio: 4 / 3; width: 100%; }
  .detail__body { display: grid; gap: 1rem; justify-items: start; }
  .detail h2 { text-transform: uppercase; font-size: 1.6rem; letter-spacing: 0.06em; }
  .detail h3 { text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.08em; margin-top: 0.5rem; }
  .detail dl { display: grid; gap: 0.3rem; width: 100%; }
  .detail dl div { display: flex; justify-content: space-between; border-bottom: 1px solid #262626; padding: 0.35rem 0; }
  .detail dt { color: var(--color-muted); }
  .detail dd { font-weight: 700; }
  .detail ul { padding-left: 1.2rem; }
  .policy { max-width: 640px; margin: 0 auto; width: 100%; }
  @media (max-width: 760px) {
    .detail { grid-template-columns: 1fr; gap: 1.5rem; }
    .detail--reverse .detail__img { order: 0; }
  }
</style>
