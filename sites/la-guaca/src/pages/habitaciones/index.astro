---
import ClosingCta from "@/components/ClosingCta.astro";
import LinkButton from "@/components/LinkButton.astro";
import RoomMeta from "@/components/RoomMeta.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import InfoGrid from "@/components/sections/InfoGrid.astro";
import PageHero from "@/components/sections/PageHero.astro";
import { siteConfig } from "@/config/site";
import { IMAGES, INCLUDED, PAGES, ROOMS, STAY_INFO, UI_LABELS } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const page = PAGES.rooms;
---

<BaseLayout
  title={`${page.meta.title} | ${siteConfig.name}`}
  description={page.meta.description}
  headerTone="dark"
>
  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    sideLeft={UI_LABELS.roomsCount(ROOMS.length)}
    sideRight={UI_LABELS.openAllYear}
  />

  <section class="rooms-grid">
    <div class="container">
      <ul class="rooms-grid__list">
        {
          ROOMS.map((room, i) => (
            <li data-reveal style={`--reveal-delay: ${(i % 2) * 0.1}s`}>
              <a href={`/rooms/${room.slug}`} class="room-card">
                <div class="media room-card__media">
                  <img src={room.image} alt={room.name} loading={i < 2 ? "eager" : "lazy"} />
                </div>
                <div class="room-card__body">
                  <h2 class="t-h3">{room.name}</h2>
                  <RoomMeta room={room} />
                  <p class="t-lead room-card__price">{UI_LABELS.fromPerNight(room.price)}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section rooms-overview">
    <div class="container rooms-overview__inner">
      <SectionHeading label={page.yourStay(siteConfig.name)} title={page.overview.title} />
      <div class="media rooms-overview__image" data-reveal>
        <img src={IMAGES.roomsOverview} alt="" loading="lazy" />
      </div>
      <p class="t-lead rooms-overview__text" data-reveal>
        {page.overview.text}
      </p>
      <div data-reveal>
        <LinkButton href="booking">{UI_LABELS.checkAvailability}</LinkButton>
      </div>
    </div>
  </section>

  <FeatureGrid title={page.included.title} items={INCLUDED} numbered />

  <InfoGrid
    tone="brown"
    label={page.info.label}
    title={page.info.title}
    items={STAY_INFO}
    image={IMAGES.roomsInfo}
  />

  <ClosingCta />
</BaseLayout>

<style>
  .rooms-grid {
    padding-bottom: 0;
  }

  .rooms-overview {
    padding-bottom: 0;
  }

  .rooms-overview__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .rooms-overview__image {
    position: relative;
    z-index: -1;
    width: 640px;
    max-width: 100%;
    aspect-ratio: 640 / 440;
    margin-top: -16px;
  }

  .rooms-overview__text {
    max-width: 480px;
    margin: 64px 0 24px;
  }

  .rooms-grid__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 16px;
  }

  .room-card {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .room-card__media {
    aspect-ratio: 680 / 510;
  }

  .room-card__media img {
    transition: transform 1.2s var(--ease-out);
  }

  .room-card:hover .room-card__media img {
    transform: scale(1.04);
  }

  .room-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .room-card__price {
    margin-top: 12px;
  }

  @media (max-width: 809px) {
    .rooms-overview__image {
      margin-top: 32px;
      z-index: auto;
    }

    .rooms-overview__text {
      margin-top: 40px;
    }

    .rooms-grid__list {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .room-card {
      gap: 24px;
    }
  }
</style>
