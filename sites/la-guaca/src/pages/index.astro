---
import BrandMark from "@/components/BrandMark.astro";
import ClosingCta from "@/components/ClosingCta.astro";
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ExperienceShowcase from "@/components/sections/ExperienceShowcase.astro";
import HomeHero from "@/components/sections/HomeHero.astro";
import ImageStatement from "@/components/sections/ImageStatement.astro";
import RoomsSlider from "@/components/sections/RoomsSlider.astro";
import StaggeredGallery from "@/components/sections/StaggeredGallery.astro";
import Ticker from "@/components/sections/Ticker.astro";
import { EXPERIENCES, IMAGES, PAGES, ROOMS } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const page = PAGES.home;
const highlights = page.highlights(ROOMS.length);

const showcase = EXPERIENCES.filter((exp) => ["montana", "mar", "vida-local"].includes(exp.id));
---

<BaseLayout>
  <HomeHero
    image={IMAGES.homeHero}
    label={page.hero.label}
    title={page.hero.title}
    sideLeft={page.hero.sideLeft}
    sideRight={page.hero.sideRight}
    intro={page.hero.intro}
  />

  <ImageStatement image={IMAGES.homeIntro} align="spread">
    <BrandMark />
    <div class="highlights" data-reveal>
      {
        highlights.map((block) => (
          <div class="highlights__block">
            <p class="t-label">{block.label}</p>
            <ul>
              {block.items.map((item) => (
                <li class="t-body">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <SectionHeading title={page.slowDown.title} text={page.slowDown.text}>
      <LinkButton href="/retreat" variant="primary" blockMobile>{page.slowDown.cta}</LinkButton>
    </SectionHeading>
  </ImageStatement>

  <ImageStatement image={IMAGES.homeWellness}>
    <SectionHeading
      title={page.wellness.title}
      sideLeft={page.wellness.sideLeft}
      sideRight={page.wellness.sideRight}
    >
      <LinkButton href="/experience#bienestar" variant="primary" blockMobile>
        {page.wellness.cta}
      </LinkButton>
    </SectionHeading>
  </ImageStatement>

  <RoomsSlider
    rooms={ROOMS}
    title={page.rooms.title}
    text={page.rooms.text}
  />

  <StaggeredGallery
    label={page.dining.label}
    title={page.dining.title}
    text={page.dining.text}
    images={IMAGES.homeDining}
  />

  <ExperienceShowcase
    label={page.experiences.label}
    title={page.experiences.title}
    image={IMAGES.homeExperiences}
    hoverImages={IMAGES.homeExperiencesHover}
    experiences={showcase}
  />

  <Ticker
    rows={[
      { text: page.ticker[0], image: IMAGES.ticker[0] },
      { text: page.ticker[1], image: IMAGES.ticker[1] },
    ]}
  />

  <ClosingCta />
</BaseLayout>

<style>
  .highlights {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 32px;
    width: 100%;
  }

  .highlights::before {
    content: "";
    grid-column: 2;
    grid-row: 1;
    background: currentColor;
  }

  .highlights__block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 12px 0;
    text-align: left;
  }

  .highlights__block:first-child {
    grid-column: 1;
    grid-row: 1;
    align-items: flex-end;
    text-align: right;
  }

  .highlights__block:last-child {
    grid-column: 3;
    grid-row: 1;
  }
</style>
