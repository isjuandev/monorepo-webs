---
import ContactForm from "@/components/ContactForm.astro";
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import FaqList from "@/components/sections/FaqList.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import ImageStatement from "@/components/sections/ImageStatement.astro";
import PageHero from "@/components/sections/PageHero.astro";
import { siteConfig } from "@/config/site";
import { IMAGES, PAGES, whatsappUrl } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { contact } = siteConfig;

const page = PAGES.contact;

const reachItems = [
  {
    title: page.reach.whatsapp.title,
    text: page.reach.whatsapp.text,
    link: { label: page.reach.whatsapp.cta, href: whatsappUrl() },
  },
  {
    title: page.reach.call.title,
    text: contact.phone,
    link: contact.phone
      ? { label: page.reach.call.cta, href: `tel:${contact.phone.replace(/\s/g, "")}` }
      : undefined,
  },
  {
    title: page.reach.write.title,
    text: page.reach.write.text,
    link: contact.email
      ? { label: page.reach.write.cta, href: `mailto:${contact.email}` }
      : undefined,
  },
];
---

<BaseLayout
  title={`${page.meta.title} | ${siteConfig.name}`}
  description={page.meta.description}
>
  <PageHero
    tone="brown"
    label={page.hero.label}
    title={page.hero.title}
    sideLeft={page.hero.sideLeft}
    sideRight={page.hero.sideRight}
  />

  <ImageStatement image={IMAGES.contactHero} overlay={false} />

  <section class="section">
    <div class="container">
      <SectionHeading
        label={page.form.label}
        title={page.form.title}
        text={page.form.text}
      />
      <ContactForm />
    </div>
  </section>

  <FeatureGrid title={page.reach.title} items={reachItems} />

  <FaqList label={page.faq.label} title={page.faq.title} items={PAGES.faq} id="preguntas" />

  <section class="section bg-brown directions">
    <div class="container">
      <SectionHeading
        label={page.directions.label}
        title={page.directions.title}
        text={page.directions.text}
      >
        <LinkButton href="maps" variant="primary" blockMobile>{page.directions.cta}</LinkButton>
      </SectionHeading>
    </div>
  </section>

</BaseLayout>

<style>
  .directions {
    padding-bottom: 200px;
  }

  @media (max-width: 809px) {
    .directions {
      padding-bottom: 120px;
    }
  }
</style>
