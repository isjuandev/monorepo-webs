---
import { type Room, UI_LABELS } from "@/data/content";

export interface Props {
  room: Pick<Room, "hours" | "highlight">;
  showHighlight?: boolean;
}

const { room, showHighlight = true } = Astro.props;
---

<span class="room-meta t-body">
  <span>{UI_LABELS.hoursIncluded(room.hours)}</span>
  {
    showHighlight && (
      <>
        <i aria-hidden="true" />
        <span>{room.highlight}</span>
      </>
    )
  }
</span>

<style>
  .room-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .room-meta i {
    display: inline-block;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
  }
</style>
