---
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { UI_LABELS } from "@/data/content";

export interface Props {
  title?: string;
  text?: string;
  sideLeft?: string;
  sideRight?: string;
}

const {
  title = UI_LABELS.closingCta.title,
  text = UI_LABELS.closingCta.text,
  sideLeft = UI_LABELS.closingCta.sideLeft,
  sideRight = UI_LABELS.closingCta.sideRight,
} = Astro.props;
---

<section class="section bg-brown closing-cta">
  <div class="container">
    <SectionHeading title={title} text={text} sideLeft={sideLeft} sideRight={sideRight}>
      <LinkButton href="booking" variant="primary" blockMobile>{UI_LABELS.checkAvailability}</LinkButton>
      <LinkButton href="maps">{UI_LABELS.directions}</LinkButton>
    </SectionHeading>
  </div>
</section>

<style>
  .closing-cta {
    padding-bottom: 200px;
  }

  .closing-cta :global(.heading__actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 32px;
  }

  @media (max-width: 809px) {
    .closing-cta {
      padding-bottom: 120px;
    }

    .closing-cta :global(.heading__actions) {
      width: 100%;
      flex-direction: column;
    }
  }
</style>
