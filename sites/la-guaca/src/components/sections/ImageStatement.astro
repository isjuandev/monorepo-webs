---
export interface Props {
  image: string;
  /** Versión vertical para pantallas de hasta 809px */
  imageMobile?: string;
  /** Altura de la sección; "screen" ocupa el viewport completo */
  height?: "screen" | "auto";
  overlay?: boolean;
  align?: "center" | "spread";
  id?: string;
}

const { image, imageMobile, height = "screen", overlay = true, align = "center", id } = Astro.props;
---

<section
  class:list={["image-statement tone-light", `image-statement--${height}`, `is-${align}`]}
  id={id}
>
  <div class="parallax" data-parallax aria-hidden="true">
    {
      imageMobile ? (
        <picture>
          <source media="(max-width: 809px)" srcset={imageMobile} />
          <img src={image} alt="" loading="lazy" decoding="async" />
        </picture>
      ) : (
        <img src={image} alt="" loading="lazy" decoding="async" />
      )
    }
  </div>
  {overlay && <div class="media-overlay"></div>}
  {
    Astro.slots.has("default") && (
      <div class="container image-statement__content">
        <slot />
      </div>
    )
  }
</section>

<style>
  .image-statement {
    position: relative;
    overflow: hidden;
  }

  .parallax picture {
    display: contents;
  }

  .image-statement--screen {
    min-height: 100vh;
  }

  .image-statement--auto {
    padding: 80px 0;
  }

  .image-statement__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: inherit;
    padding-top: 80px;
    padding-bottom: 48px;
    text-align: center;
  }

  .is-spread .image-statement__content {
    justify-content: space-between;
  }
</style>
