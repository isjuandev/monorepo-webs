---
import LinkButton from "@/components/LinkButton.astro";
import type { Photo } from "@/data/content";

export interface Props {
  photos: Photo[];
  label: string;
  /** Indicación para deslizar (solo móvil) */
  hint: string;
  /** Tarjeta de reserva que rellena las celdas libres del mosaico (solo escritorio) */
  cta?: { title: string; label: string; href: string };
}

const { photos, label, hint, cta } = Astro.props;

// Mosaico de 4 columnas con la portada en 2x2: ocupa photos.length + 3 celdas.
const COLUMNS = 4;
const freeCells = (COLUMNS - ((photos.length + 3) % COLUMNS)) % COLUMNS;
---

<section class="room-gallery" aria-label={label}>
  <ul class="room-gallery__list">
    {
      photos.map((photo, i) => (
        <li class:list={["room-gallery__item", i === 0 && "room-gallery__item--featured"]}>
          <img
            src={photo.src}
            alt={photo.alt}
            loading={i < 2 ? "eager" : "lazy"}
            decoding="async"
            draggable="false"
          />
        </li>
      ))
    }
    {
      cta && freeCells > 0 && (
        <li class="room-gallery__cta" style={`grid-column: span ${freeCells}`}>
          <p class="t-h3">{cta.title}</p>
          <LinkButton href={cta.href} variant="primary">
            {cta.label}
          </LinkButton>
        </li>
      )
    }
  </ul>
  {photos.length > 1 && <p class="t-label t-muted room-gallery__hint">{hint}</p>}
</section>

<style>
  /*
   * Fotos en retrato (3:4 y 9:16). Móvil primero: carrusel horizontal con scroll-snap,
   * sin JavaScript. En escritorio pasa a mosaico de 4 columnas con la portada en 2x2.
   */
  .room-gallery {
    padding-top: 16px;
  }

  .room-gallery__list {
    display: flex;
    gap: 8px;
    padding: 0 var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .room-gallery__list::-webkit-scrollbar {
    display: none;
  }

  .room-gallery__item {
    position: relative;
    flex: 0 0 82%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-media);
    scroll-snap-align: start;
  }

  .room-gallery__item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .room-gallery__hint {
    padding: 16px var(--gutter) 0;
    text-align: center;
  }

  .room-gallery__cta {
    display: none;
  }

  @media (min-width: 810px) {
    .room-gallery__list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
      overflow: visible;
    }

    .room-gallery__item--featured {
      grid-column: span 2;
      grid-row: span 2;
      aspect-ratio: auto;
    }

    .room-gallery__hint {
      display: none;
    }

    .room-gallery__cta {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 24px;
      padding: 32px;
      border: 1px solid var(--color-line-light);
      text-align: center;
    }
  }
</style>
