---
import LinkButton from "@/components/LinkButton.astro";
import SplitText from "@/components/SplitText.astro";
import Stars from "@/components/Stars.astro";
import { siteConfig } from "@/config/site";
import { UI_LABELS } from "@/data/content";

export interface HeroAction {
  label: string;
  href: string;
}

export interface Props {
  image: string;
  /** Versión vertical para pantallas de hasta 809px */
  imageMobile?: string;
  title: string;
  label: string;
  sideLeft: string;
  sideRight: string;
  intro: string;
  /** CTA principal (p. ej. WhatsApp) y secundario; se muestran si no hay valoraciones */
  primaryAction?: HeroAction;
  secondaryAction?: HeroAction;
}

const {
  image,
  imageMobile,
  title,
  label,
  sideLeft,
  sideRight,
  intro,
  primaryAction,
  secondaryAction,
} = Astro.props;
const { rating } = siteConfig;
---

<section class="home-hero tone-light" data-intro="fade">
  <div class="home-hero__media" aria-hidden="true" data-intro="zoom">
    <picture>
      {imageMobile && <source media="(max-width: 809px)" srcset={imageMobile} />}
      <img src={image} alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class="media-overlay"></div>
    <div class="home-hero__top-fade"></div>
  </div>

  <div class="home-hero__content">
    <div class="home-hero__heading">
      <p class="t-label home-hero__label" data-reveal style="--reveal-delay: 1s">{label}</p>
      <p class="t-label home-hero__side home-hero__side--left" data-reveal style="--reveal-delay: 1.2s">
        {sideLeft}
      </p>
      <SplitText text={title} as="h1" class="t-display" delay={0.85} />
      <p class="t-label home-hero__side home-hero__side--right" data-reveal style="--reveal-delay: 1.2s">
        {sideRight}
      </p>
    </div>

    <div class="home-hero__info">
      <p class="t-lead home-hero__intro" data-reveal style="--reveal-delay: 1.1s">{intro}</p>
      {
        rating && (
          <div class="home-hero__badge" data-reveal style="--reveal-delay: 1.3s">
            <div class="home-hero__badge-head">
              <Stars />
              <span class="t-label">{UI_LABELS.reviews}</span>
            </div>
            <div class="home-hero__badge-body">
              <p class="home-hero__score">
                <span class="t-big">{rating.score}</span>
                <span class="t-body">/5.0</span>
              </p>
              <p class="home-hero__score-text">
                <span class="t-body">{UI_LABELS.excellent}</span>
                <span class="t-small">{UI_LABELS.basedOnReviews(rating.reviews)}</span>
              </p>
            </div>
          </div>
        )
      }
      {
        !rating && (primaryAction || secondaryAction) && (
          <div class="home-hero__actions" data-reveal style="--reveal-delay: 1.3s">
            {primaryAction && (
              <LinkButton href={primaryAction.href} variant="primary" blockMobile>
                {primaryAction.label}
              </LinkButton>
            )}
            {secondaryAction && (
              <LinkButton href={secondaryAction.href}>{secondaryAction.label}</LinkButton>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    height: 100vh;
    min-height: 640px;
    overflow: hidden;
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
  }

  .home-hero__media picture {
    display: contents;
  }

  .home-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__top-fade {
    position: absolute;
    inset: 0 0 auto;
    height: 160px;
    background: linear-gradient(to bottom, var(--color-shade), var(--color-shade-clear));
  }

  .home-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--gutter);
  }

  .home-hero__heading {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .home-hero__heading :global(h1) {
    max-width: 680px;
  }

  .home-hero__label {
    margin-bottom: 16px;
  }

  .home-hero__side {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .home-hero__side.is-visible {
    transform: translateY(-50%);
  }

  .home-hero__side--left {
    right: calc(50% + 354px);
  }

  .home-hero__side--right {
    left: calc(50% + 354px);
  }

  .home-hero__info {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .home-hero__intro {
    max-width: 240px;
  }

  .home-hero__actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .home-hero__badge {
    width: 296px;
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .home-hero__badge-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px;
    border-bottom: 1px solid var(--color-line-dark);
  }

  .home-hero__badge-body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 24px 12px 8px;
  }

  .home-hero__score {
    display: flex;
    align-items: flex-start;
    gap: 2px;
  }

  .home-hero__score .t-body {
    margin-top: 6px;
  }

  .home-hero__score-text {
    display: flex;
    flex-direction: column;
    width: 146px;
    margin-top: 6px;
  }

  @media (max-width: 1199px) {
    .home-hero__side--left {
      right: auto;
      left: 0;
    }

    .home-hero__side--right {
      left: auto;
      right: 0;
    }

    .home-hero__side {
      top: calc(50% + 140px);
    }
  }

  @media (max-width: 809px) {
    .home-hero__content {
      padding: var(--gutter) var(--gutter) 24px;
    }

    .home-hero__heading :global(h1) {
      max-width: 300px;
    }

    .home-hero__side--left {
      position: static;
      order: 3;
      margin-top: 16px;
      transform: none;
    }

    .home-hero__side.home-hero__side--left.is-visible {
      transform: none;
    }

    .home-hero__side--right,
    .home-hero__intro {
      display: none;
    }

    .home-hero__badge {
      width: 100%;
    }

    .home-hero__info {
      flex-direction: column;
      align-items: stretch;
    }

    .home-hero__actions {
      flex-direction: column;
      gap: 12px;
    }

    .home-hero__score-text {
      width: 209px;
    }
  }
</style>
