---
import MediaHero from "@/components/sections/MediaHero.astro";
import { OFFERS, type Offer } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return OFFERS.map((offer) => ({ params: { slug: offer.slug }, props: { offer } }));
}

interface Props {
  offer: Offer;
}

const { offer } = Astro.props;
---

<BaseLayout page={offer.title} ogImage={offer.image.src}>
  <MediaHero image={{ src: offer.image.src, alt: offer.heroAlt }} />
  <section class="section offer-detail">
    <div class="wrapper">
      <div class="offer-detail__head">
        <h1 class="t-h1">{offer.title}</h1>
        <p class="t-lead offer-detail__lead">{offer.summary}</p>
      </div>
      <div class="offer-detail__body t-body">
        {offer.paragraphs.map((text) => (text ? <p>{text}</p> : <p aria-hidden="true"><br /></p>))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .offer-detail__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .offer-detail__lead {
    max-width: 550px;
  }

  .offer-detail__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 750px;
    margin: 0 auto;
    padding-top: 64px;
  }
</style>
