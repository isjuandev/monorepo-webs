---
import DineCards from "@/components/sections/DineCards.astro";
import ExperienceStack from "@/components/sections/ExperienceStack.astro";
import FaqList from "@/components/sections/FaqList.astro";
import HomeHero from "@/components/sections/HomeHero.astro";
import ManagerNote from "@/components/sections/ManagerNote.astro";
import OfferTicker from "@/components/sections/OfferTicker.astro";
import OffersList from "@/components/sections/OffersList.astro";
import Reviews from "@/components/sections/Reviews.astro";
import RoomCards from "@/components/sections/RoomCards.astro";
import { FAQ_INTRO, REVIEWS_INTRO, ROOMS_INTRO } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <HomeHero />
  <OfferTicker />
  <DineCards />
  <ExperienceStack />
  <RoomCards intro={ROOMS_INTRO} />
  <OffersList />
  <Reviews intro={REVIEWS_INTRO} />
  <ManagerNote />
  <FaqList intro={FAQ_INTRO} />
</BaseLayout>
