---
import SectionIntro from "@/components/SectionIntro.astro";
import { DINE_CARDS, DINE_INTRO } from "@/data/content";
---

<section class="section dine">
  <div class="wrapper dine__wrapper">
    <SectionIntro {...DINE_INTRO} />
    <div class="dine__cards">
      {
        DINE_CARDS.map((card) => (
          <a class="dine-card" href={card.href}>
            <span class="dine-card__media">
              <img src={card.image.src} alt={card.image.alt} width="1168" height="784" loading="lazy" />
            </span>
            <span class="dine-card__shade" aria-hidden="true" />
            <span class="dine-card__content">
              <span class="t-h4 dine-card__title">{card.title}</span>
              <span class="t-small">{card.subtitle}</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dine__wrapper {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .dine__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .dine-card {
    position: relative;
    display: block;
    height: 500px;
    overflow: hidden;
    background: transparent;
    color: #ffffff;
    transition:
      background-color 0.6s var(--ease-layout),
      color 0.6s var(--ease-layout);
  }

  .dine-card__media {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 147.8%;
    overflow: hidden;
    transform: translate(-50%, -50%);
    transition:
      width 0.6s var(--ease-layout),
      height 0.6s var(--ease-layout);
  }

  .dine-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dine-card__shade {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.16);
    transition: opacity 0.6s var(--ease-layout);
  }

  .dine-card__content {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px;
  }

  @media (hover: hover) and (min-width: 810px) {
    .dine-card:hover {
      background: #ffffff;
      color: #0b0b0b;
    }

    .dine-card:hover .dine-card__media {
      width: 40.2%;
      height: 59.4%;
    }

    .dine-card:hover .dine-card__shade {
      opacity: 0;
    }
  }

  @media (max-width: 1199.98px) {
    .dine-card {
      height: 390px;
    }
  }

  @media (max-width: 809.98px) {
    .dine__cards {
      grid-template-columns: 1fr;
    }

    .dine-card {
      height: 380px;
      background: #ffffff;
      color: #000000;
    }

    .dine-card__media {
      width: 40%;
      height: 48.2%;
    }

    .dine-card__shade {
      opacity: 0;
    }
  }
</style>
