---
/**
 * Texto "fit" de Framer: un SVG con viewBox fijo cuyo texto ocupa todo el ancho disponible.
 * El tamaño de letra es igual a la altura del viewBox (line-height 1em).
 */
export interface Props {
  text: string;
  width: number;
  height: number;
  tag?: "h1" | "p" | "span";
  class?: string;
}

const { text, width, height, tag: Tag = "h1", class: className } = Astro.props;
---

<svg
  class:list={["fit-title", className]}
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label={text}
>
  <foreignObject width="100%" height="100%">
    <Tag class="fit-title__text" style={`font-size:${height}px`} aria-hidden="true">{text}</Tag>
  </foreignObject>
</svg>

<style>
  .fit-title {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .fit-title foreignObject {
    overflow: visible;
  }

  .fit-title__text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    color: #ffffff;
  }
</style>
