---
import { FaqAccordion } from "@/components/FaqAccordion";
import SectionIntro from "@/components/SectionIntro.astro";
import { FAQ } from "@/data/content";
---

<section class="section faq" id={FAQ.intro.id}>
  <div class="section__inner">
    <div data-reveal>
      <SectionIntro intro={FAQ.intro} />
    </div>
    <FaqAccordion client:visible items={FAQ.items} />
  </div>
</section>

<style>
  .faq :global(.faq-list) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .faq :global(.faq-row) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: transform 0.4s cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  .faq :global(.faq-row.is-open) {
    transform: scale(0.98);
  }

  .faq :global(.faq-row__question) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 23px 24px;
    font-size: 16px;
    line-height: 1.2;
    text-align: left;
  }

  .faq :global(.faq-row__icon) {
    flex: none;
    transform: rotate(45deg);
    transition: transform 0.4s cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  .faq :global(.is-open .faq-row__icon) {
    transform: rotate(0deg) scale(0.8);
  }

  .faq :global(.faq-row__answer) {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .faq :global(.is-open .faq-row__answer) {
    grid-template-rows: 1fr;
  }

  .faq :global(.faq-row__answer > div) {
    overflow: hidden;
  }

  .faq :global(.is-open .faq-row__question) {
    padding-bottom: 12px;
  }

  .faq :global(.faq-row__answer p) {
    padding: 0 24px 24px;
    font-size: 16px;
    line-height: 1.2;
    color: var(--color-muted);
  }

  @media (max-width: 809px) {
    .faq :global(.faq-row__question) {
      padding: 20px;
      font-size: 14px;
    }

    .faq :global(.faq-row__answer p) {
      padding: 0 20px 20px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq :global(.faq-row),
    .faq :global(.faq-row__icon),
    .faq :global(.faq-row__answer) {
      transition: none;
    }
  }
</style>
