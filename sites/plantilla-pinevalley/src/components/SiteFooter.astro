---
import Button from "@/components/Button.astro";
import Lines from "@/components/Lines.astro";
import { FOOTER_LINKS, siteConfig } from "@/config/site";
import { BOOKING, FOOTER, UI_LABELS } from "@/data/content";

const year = new Date().getFullYear();
const copyright = FOOTER.copyright.replace("{year}", String(year));
---

<footer class="site-footer">
  <img
    class="site-footer__bg"
    src={FOOTER.background.src}
    alt={FOOTER.background.alt}
    width="1084"
    height="1029"
    loading="lazy"
    decoding="async"
  />
  <div class="site-footer__content">
    <div class="site-footer__top">
      <div class="site-footer__intro">
        <img
          class="site-footer__mark"
          src={FOOTER.logoMark.src}
          alt={FOOTER.logoMark.alt}
          width="120"
          height="80"
          loading="lazy"
        />
        <div class="site-footer__brand">
          <a class="site-footer__logo" href="/">{siteConfig.logoText}</a>
          <p class="site-footer__text"><Lines text={FOOTER.text} keep /></p>
          <Button href={`/#${BOOKING.intro.id}`} label={FOOTER.cta} variant="light" />
        </div>
      </div>

      <div class="site-footer__links">
        <nav class="site-footer__col site-footer__col--nav" aria-label={UI_LABELS.footerNav}>
          <p class="site-footer__heading">{FOOTER.navigationTitle}</p>
          <ul>
            {
              FOOTER_LINKS.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="site-footer__col site-footer__col--contact">
          <p class="site-footer__heading">{FOOTER.contactTitle}</p>
          <ul>
            <li>
              <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
            </li>
            <li>
              <a href={siteConfig.contact.phoneHref}>{siteConfig.contact.phone}</a>
            </li>
          </ul>
        </div>
        <div class="site-footer__col site-footer__col--follow">
          <p class="site-footer__heading">{FOOTER.followTitle}</p>
          <ul>
            {
              siteConfig.socials.map((social) => (
                <li>
                  <a href={social.href} target="_blank" rel="noopener noreferrer">
                    {social.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>{copyright}</p>
      <p class="site-footer__available">
        <span class="site-footer__dot" aria-hidden="true"></span>
        {FOOTER.available}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    height: 1200px;
    overflow: hidden;
    border-radius: var(--radius-footer) var(--radius-footer) 0 0;
    color: var(--color-on-image);
    background: var(--color-placeholder);
  }

  .site-footer__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  .site-footer__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 72px var(--gutter) 8px;
  }

  .site-footer__top {
    display: flex;
    flex-direction: column;
    gap: 96px;
  }

  .site-footer__intro {
    display: flex;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: flex-start;
  }

  .site-footer__mark {
    width: 120px;
    height: 80px;
    object-fit: contain;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .site-footer__logo {
    font-size: 20px;
    font-weight: 900;
    line-height: 1.2;
  }

  .site-footer__text {
    max-width: 360px;
    margin-top: -2px;
    font-size: 16px;
    line-height: 1.2;
  }

  .site-footer__links {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .site-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .site-footer__col--contact ul,
  .site-footer__col--follow ul {
    gap: 10px;
  }

  .site-footer__heading {
    font-size: 16px;
    line-height: 1.2;
  }

  .site-footer__col li {
    line-height: 1;
  }

  .site-footer__col a {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .site-footer__col a:hover {
    color: var(--color-on-image-hover);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    line-height: 1.2;
  }

  .site-footer__available {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .site-footer__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-available-glow);
  }

  .site-footer__dot::after {
    content: "";
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: var(--color-available);
  }

  .site-footer__dot::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-available-glow);
    animation: pulse 1.6s ease-out infinite;
  }

  @keyframes pulse {
    to {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  @media (max-width: 1199px) {
    .site-footer {
      height: 1000px;
    }
  }

  @media (max-width: 809px) {
    .site-footer__content {
      padding-top: 32px;
    }

    .site-footer__top {
      gap: 72px;
    }

    .site-footer__intro {
      flex-direction: column;
      gap: 32px;
    }

    .site-footer__mark {
      width: 54px;
      height: 36px;
    }

    .site-footer__logo {
      font-size: 16px;
    }

    .site-footer__links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      row-gap: 72px;
    }

    .site-footer__col--contact {
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .site-footer__bottom {
      flex-direction: column-reverse;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__dot::before {
      animation: none;
    }
  }
</style>
