---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { pageTitle, siteConfig } from "@/config/site";
import { UI_LABELS } from "@/data/content";
import SEO from "@repo/ui/astro/SEO.astro";
import "@/styles/theme.css";
import "@/styles/global.css";

export interface Props {
  /** Nombre de la página; se compone como "Página — <marca>" */
  page?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Cabecera blanca desde el inicio (páginas sin hero de imagen) */
  solidHeader?: boolean;
}

const {
  page,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  noindex = false,
  solidHeader = false,
} = Astro.props;

const title = pageTitle(page);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  telephone: siteConfig.contact.phone,
  email: siteConfig.contact.email,
  address: siteConfig.contact.address,
  image: new URL(siteConfig.ogImage ?? "/images/og-image.jpg", siteConfig.url).href,
};
---

<!doctype html>
<html lang={siteConfig.locale?.split("_")[0] ?? "en"}>
  <head>
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      locale={siteConfig.locale}
      siteName={siteConfig.name}
      noindex={noindex}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      siteConfig.preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <meta name="theme-color" content={siteConfig.themeColor} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">{UI_LABELS.skipToContent}</a>
    <SiteHeader solid={solidHeader} />
    <main id="contenido" class="site-main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "@/scripts/motion";
    </script>
  </body>
</html>

<style>
  .site-main {
    position: relative;
    overflow-x: clip;
  }
</style>
