---
import SectionHeading from "@/components/SectionHeading.astro";
import type { Experience } from "@/data/content";

export interface Props {
  label: string;
  title: string;
  image: string;
  experiences: Experience[];
}

const { label, title, image, experiences } = Astro.props;
---

<section class="showcase tone-light" data-hover-group>
  <div class="showcase__media" aria-hidden="true">
    <img src={image} alt="" class="is-active" data-hover-image="default" loading="lazy" />
    {
      experiences.map((exp) => (
        <img src={exp.image} alt="" data-hover-image={exp.id} loading="lazy" />
      ))
    }
    <div class="media-overlay"></div>
  </div>

  <div class="container showcase__content">
    <SectionHeading label={label} title={title} />
    <ul class="showcase__links">
      {
        experiences.map((exp) => (
          <li>
            <a href={`/experience#${exp.id}`} class="showcase__link" data-hover-trigger={exp.id}>
              <span class="t-label">{exp.label}</span>
              <span class="t-h3">{exp.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .showcase {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .showcase__media {
    position: absolute;
    inset: 0;
  }

  .showcase__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.05);
    transition:
      opacity 0.8s ease,
      transform 1.2s var(--ease-out);
  }

  .showcase__media img.is-active {
    opacity: 1;
    transform: none;
  }

  .showcase__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100vh;
    padding-top: 120px;
    padding-bottom: 80px;
  }

  .showcase__links {
    display: flex;
    justify-content: center;
  }

  .showcase__links li + li {
    border-left: 1px solid var(--color-light-muted);
  }

  .showcase__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 304px;
    padding: 16px 52px;
    text-align: center;
    transition: opacity 0.3s ease;
  }

  .showcase__links:hover .showcase__link:not(:hover) {
    opacity: 0.6;
  }

  @media (max-width: 809px) {
    .showcase__content {
      gap: 64px;
      padding-top: 120px;
      padding-bottom: 56px;
    }

    .showcase__links {
      flex-direction: column;
    }

    .showcase__links li + li {
      border-left: 0;
      border-top: 1px solid var(--color-light-muted);
    }

    .showcase__link {
      width: 100%;
      padding: 24px 0;
    }
  }
</style>
