---
import ArrowIcon from "@/components/ArrowIcon.astro";
import Stars from "@/components/Stars.astro";
import { NAV_LINKS, siteConfig } from "@/config/site";
import { STAY_INFO } from "@/data/content";

export interface Props {
  /** Color del texto sobre el hero de la página antes de hacer scroll */
  tone?: "light" | "dark";
}

const { tone = "light" } = Astro.props;
const { contact, rating } = siteConfig;
const year = new Date().getFullYear();
---

<header class="site-header" data-header data-tone={tone}>
  <div class="site-header__bar" data-intro="fade" style="--intro-delay: 0.35s">
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="menu-toggle__lines" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span class="menu-toggle__label" data-menu-label>Menú</span>
    </button>
    <a href="/" class="t-logo site-header__logo">{siteConfig.name}</a>
    <a
      href={siteConfig.bookingUrl}
      class="btn btn--secondary site-header__cta"
      target="_blank"
      rel="noopener noreferrer"
    >
      Ver disponibilidad
      <ArrowIcon direction="external" />
    </a>
  </div>

  <div class="site-menu" id="site-menu" data-menu aria-hidden="true">
    <div class="site-menu__panel site-menu__panel--nav">
      <nav aria-label="Principal">
        <ul class="site-menu__links">
          {
            NAV_LINKS.map((link, i) => (
              <li style={`--d: ${0.15 + i * 0.05}s`}>
                <a href={link.href} class="t-big site-menu__link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="site-menu__footer">
        {
          rating && (
            <div class="site-menu__rating">
              <Stars />
              <span>{rating.score}</span>
              <span class="t-muted">({rating.reviews} reseñas)</span>
            </div>
          )
        }
        <p class="t-label t-muted">© {year}, Todos los derechos reservados</p>
      </div>
    </div>

    <div class="site-menu__panel site-menu__panel--info">
      <div class="site-menu__block">
        <p class="t-label t-muted">Horarios</p>
        <ul class="site-menu__hours">
          {
            STAY_INFO.slice(0, 2).map((item) => (
              <li>
                <span class="t-label t-muted">{item.label}</span>
                <span class="t-h3">{item.value}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="site-menu__block">
        <div class="site-menu__group">
          <p class="t-label t-muted">Contacto</p>
          {contact.email && <a href={`mailto:${contact.email}`} class="t-lead">{contact.email}</a>}
          {
            contact.phone && (
              <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="t-lead">
                {contact.phone}
              </a>
            )
          }
        </div>
        {
          contact.address && (
            <div class="site-menu__group">
              <p class="t-label t-muted">Ubicación</p>
              <a
                href={siteConfig.mapsUrl}
                class="t-lead site-menu__address"
                target="_blank"
                rel="noopener noreferrer"
              >
                {contact.address}
              </a>
            </div>
          )
        }
      </div>
    </div>

    <div class="site-menu__panel site-menu__panel--cta">
      <p class="t-h3">¿Lista tu escapada?</p>
      <p class="t-lead">Consulta fechas y tarifas en nuestro motor de reservas.</p>
      <a
        href={siteConfig.bookingUrl}
        class="btn btn--secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        Ver disponibilidad
        <ArrowIcon direction="external" />
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--color-light);
    pointer-events: none;
  }

  .site-header[data-tone="dark"] {
    color: var(--color-text);
  }

  .site-header__bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-height);
    padding: 0 var(--gutter);
    pointer-events: auto;
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.4s ease,
      color 0.4s ease;
  }

  .site-header.is-hidden .site-header__bar {
    transform: translateY(-100%);
  }

  .site-header.is-solid .site-header__bar {
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .site-header.is-open .site-header__bar {
    transform: none;
    background-color: var(--color-surface);
    color: var(--color-light);
    border-bottom: 1px solid var(--color-line-light);
  }

  .menu-toggle {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  .menu-toggle__lines {
    position: relative;
    width: 20px;
    height: 20px;
  }

  .menu-toggle__lines span {
    position: absolute;
    left: 0;
    width: 20px;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }

  .menu-toggle__lines span:first-child {
    top: 7px;
  }

  .menu-toggle__lines span:last-child {
    top: 12px;
  }

  .is-open .menu-toggle__lines span:first-child {
    transform: translateY(2.5px) rotate(-45deg);
  }

  .is-open .menu-toggle__lines span:last-child {
    transform: translateY(-2.5px) rotate(45deg);
  }

  .site-header__logo {
    justify-self: center;
  }

  .site-header__cta {
    justify-self: end;
  }

  /* ---------- Menú a pantalla completa ---------- */

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1.18fr;
    padding-top: var(--header-height);
    background-color: var(--color-surface);
    color: var(--color-light);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      visibility 0s linear 0.4s;
  }

  .is-open .site-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.4s ease;
  }

  .site-menu__panel {
    display: flex;
    flex-direction: column;
  }

  .site-menu__panel--nav {
    grid-row: 1 / span 2;
    justify-content: space-between;
    border-right: 1px solid var(--color-line-light);
  }

  .site-menu__panel--info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--color-line-light);
  }

  .site-menu__links {
    padding: 24px var(--gutter);
  }

  .site-menu__links li,
  .site-menu__block,
  .site-menu__panel--cta > * {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .is-open .site-menu__links li,
  .is-open .site-menu__block,
  .is-open .site-menu__panel--cta > * {
    opacity: 1;
    transform: none;
    transition-delay: var(--d, 0.3s);
  }

  .site-menu__link {
    display: inline-block;
    padding: 4px 0;
    transition: opacity 0.3s ease;
  }

  .site-menu__links:hover .site-menu__link:not(:hover) {
    opacity: 0.5;
  }

  .site-menu__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px var(--gutter);
    border-top: 1px solid var(--color-line-light);
  }

  .site-menu__rating {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .site-menu__rating :global(.stars) {
    margin-right: 6px;
  }

  .site-menu__block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 32px;
    text-align: center;
  }

  .site-menu__block + .site-menu__block {
    border-left: 1px solid var(--color-line-light);
  }

  .site-menu__hours {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .site-menu__hours li,
  .site-menu__group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .site-menu__address {
    white-space: pre-line;
  }

  .site-menu__panel--cta {
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 32px;
    text-align: center;
  }

  .site-menu__panel--cta .btn {
    margin-top: 16px;
  }

  @media (max-width: 809px) {
    .site-header__bar {
      grid-template-columns: 1fr auto;
    }

    .site-header__cta {
      display: none;
    }

    .menu-toggle {
      order: 2;
      justify-self: end;
    }

    .menu-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .site-header__logo {
      justify-self: start;
    }

    .site-menu {
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }

    .site-menu__panel--nav {
      border-right: 0;
      text-align: center;
    }

    .site-menu__links {
      padding: 32px var(--gutter);
    }

    .site-menu__footer {
      display: none;
    }

    .site-menu__panel--info {
      grid-template-columns: 1fr;
      border-top: 1px solid var(--color-line-light);
    }

    .site-menu__block + .site-menu__block {
      border-left: 0;
      border-top: 1px solid var(--color-line-light);
    }

    .site-menu__panel--cta {
      padding: 64px var(--gutter);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const label = document.querySelector<HTMLElement>("[data-menu-label]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      menu.setAttribute("aria-hidden", String(!open));
      document.documentElement.style.overflow = open ? "hidden" : "";
      if (label) label.textContent = open ? "Cerrar" : "Menú";
    };

    toggle.addEventListener("click", () => setOpen(!header.classList.contains("is-open")));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.classList.contains("is-open")) setOpen(false);
    });

    // Se oculta al bajar y reaparece con fondo al subir, como en la referencia.
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      if (!header.classList.contains("is-open")) {
        header.classList.toggle("is-hidden", y > lastY && y > 120);
        header.classList.toggle("is-solid", y > 120);
      }
      lastY = y;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
