---
import { LEGAL_LINKS, NAV_LINKS, siteConfig } from "@/config/site";
import { IMAGES } from "@/data/content";

const { contact, socials } = siteConfig;
const year = new Date().getFullYear();

const SOCIAL_ICONS: Record<string, string> = {
  facebook:
    "M9.5 3H11V.2A19 19 0 0 0 8.8 0C6.6 0 5.1 1.4 5.1 3.9V6H2.7v3.1h2.4V16h3V9.1h2.4l.4-3.1H8V4.2c0-.9.3-1.2 1.5-1.2Z",
  x: "M12.2 1h2.3L9.5 6.8 15.4 15h-4.6L7.2 10.3 3 15H.7l5.4-6.2L.4 1h4.7l3.2 4.3Zm-.8 12.6h1.3L4.5 2.3H3.1Z",
  instagram:
    "M8 1.4c2.1 0 2.4 0 3.2.1 2.2.1 3.2 1.1 3.3 3.3v6.4c-.1 2.2-1.1 3.2-3.3 3.3H4.8c-2.2-.1-3.2-1.1-3.3-3.3V4.8c.1-2.2 1.1-3.2 3.3-3.3H8ZM8 0C5.8 0 5.6 0 4.7.1 1.8.2.2 1.8.1 4.7v6.6c.1 2.9 1.7 4.5 4.6 4.6h6.6c2.9-.1 4.5-1.7 4.6-4.6V4.7C15.8 1.8 14.2.2 11.3.1H8Zm0 3.9a4.1 4.1 0 1 0 0 8.2 4.1 4.1 0 0 0 0-8.2Zm0 6.8a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4Zm4.3-7.9a1 1 0 1 0 0 1.9 1 1 0 0 0 0-1.9Z",
};

const socialLinks = Object.entries(socials ?? {}).filter(
  (entry): entry is [string, string] => typeof entry[1] === "string" && entry[1].length > 0
);
---

<footer class="site-footer">
  <div class="parallax" data-parallax aria-hidden="true">
    <img src={IMAGES.landscape} alt="" loading="lazy" decoding="async" />
  </div>
  <div class="site-footer__card" data-reveal>
    <div class="site-footer__row site-footer__brand">
      <a href="/" class="t-logo">{siteConfig.name}</a>
      <span class="t-label">Est. {siteConfig.established}</span>
    </div>

    <div class="site-footer__row site-footer__contact">
      <div class="site-footer__group">
        <p class="t-label t-muted">Contacto</p>
        {contact.email && <a href={`mailto:${contact.email}`} class="t-lead">{contact.email}</a>}
        {
          contact.phone && (
            <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="t-lead">
              {contact.phone}
            </a>
          )
        }
      </div>
      {
        contact.address && (
          <div class="site-footer__group">
            <p class="t-label t-muted">Ubicación</p>
            <a
              href={siteConfig.mapsUrl}
              class="t-lead site-footer__address"
              target="_blank"
              rel="noopener noreferrer"
            >
              {contact.address}
            </a>
          </div>
        )
      }
    </div>

    <nav class="site-footer__row" aria-label="Pie de página">
      <ul class="site-footer__nav">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="t-h3 site-footer__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__row site-footer__bottom">
      {
        socialLinks.length > 0 && (
          <ul class="site-footer__socials">
            {socialLinks.map(([name, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener noreferrer" aria-label={name}>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d={SOCIAL_ICONS[name]} fill="currentColor" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <ul class="site-footer__legal">
        {
          LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href} class="t-small">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="t-label t-muted">© {year}, Todos los derechos reservados</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 160px var(--gutter);
    overflow: hidden;
    color: var(--color-light);
  }

  .site-footer__card {
    position: relative;
    width: 360px;
    max-width: 100%;
    background-color: var(--color-surface);
  }

  .site-footer__row {
    padding: 24px 32px;
  }

  .site-footer__row + .site-footer__row {
    border-top: 1px solid var(--color-line-light);
  }

  .site-footer__brand {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .site-footer__group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .site-footer__address {
    white-space: pre-line;
  }

  .site-footer__link {
    display: inline-block;
    padding: 4px 0;
    transition: opacity 0.3s ease;
  }

  .site-footer__nav:hover .site-footer__link:not(:hover) {
    opacity: 0.5;
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .site-footer__socials {
    display: flex;
    gap: 8px;
    margin-left: -6px;
  }

  .site-footer__socials a {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    transition: opacity 0.3s ease;
  }

  .site-footer__socials a:hover {
    opacity: 0.6;
  }

  .site-footer__socials svg {
    width: 14px;
    height: 14px;
  }

  .site-footer__legal {
    display: flex;
    gap: 16px;
  }

  .site-footer__legal a:hover {
    text-decoration: underline;
  }
</style>
