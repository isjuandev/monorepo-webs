---
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";

export interface Props {
  title?: string;
  sideLeft?: string;
  sideRight?: string;
}

const {
  title = "Tu próxima escapada",
  sideLeft = "Un retiro privado",
  sideRight = "Reserva directa",
} = Astro.props;
---

<section class="section bg-brown closing-cta">
  <div class="container">
    <SectionHeading title={title} sideLeft={sideLeft} sideRight={sideRight}>
      <LinkButton href="booking" variant="primary" blockMobile>Ver disponibilidad</LinkButton>
    </SectionHeading>
  </div>
</section>

<style>
  .closing-cta {
    padding-bottom: 240px;
  }

  @media (max-width: 809px) {
    .closing-cta {
      padding-bottom: 120px;
    }

    .closing-cta :global(.heading__actions) {
      width: 100%;
    }
  }
</style>
