---
import ArrowIcon from "@/components/ArrowIcon.astro";
import { siteConfig } from "@/config/site";

const ENQUIRY_TYPES = ["Reserva", "Experiencias", "Eventos privados", "Prensa", "Otro"];
---

<form class="contact-form" data-contact-form data-email={siteConfig.contact.email ?? ""}>
  <div class="contact-form__grid">
    <label class="contact-form__field">
      <span class="t-small">Nombre</span>
      <input type="text" name="name" placeholder="Tu nombre completo" autocomplete="name" required />
    </label>
    <label class="contact-form__field">
      <span class="t-small">Correo</span>
      <input type="email" name="email" placeholder="Tu correo" autocomplete="email" required />
    </label>
    <label class="contact-form__field">
      <span class="t-small">Teléfono</span>
      <input type="tel" name="phone" placeholder="Tu teléfono" autocomplete="tel" />
    </label>
    <label class="contact-form__field contact-form__field--select">
      <span class="t-small">Tipo de consulta</span>
      <select name="type" required>
        <option value="" disabled selected>Selecciona una opción</option>
        {ENQUIRY_TYPES.map((type) => <option value={type}>{type}</option>)}
      </select>
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" />
      </svg>
    </label>
    <label class="contact-form__field contact-form__field--full">
      <span class="t-small">Mensaje</span>
      <textarea name="message" rows="4" placeholder="Cuéntanos cómo podemos ayudarte" required
      ></textarea>
    </label>
  </div>
  <label class="contact-form__consent t-small">
    <input type="checkbox" name="consent" required />
    <span>Acepto ser contactado sobre mi consulta.</span>
  </label>
  <button type="submit" class="btn btn--primary btn--dark contact-form__submit">
    Enviar mensaje
    <ArrowIcon direction="right" />
  </button>
  <p class="t-small contact-form__status" data-form-status aria-live="polite"></p>
</form>

<style>
  .contact-form {
    width: 100%;
    max-width: 680px;
    margin: 80px auto 0;
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-line-dark);
  }

  .contact-form__field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line-dark);
  }

  .contact-form__field:nth-child(even) {
    padding-left: 16px;
    border-left: 1px solid var(--color-line-dark);
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__field input,
  .contact-form__field select,
  .contact-form__field textarea {
    width: 100%;
    padding: 4px 0;
    border: 0;
    background: transparent;
    font-size: 18px;
    letter-spacing: -0.01em;
    outline: none;
    appearance: none;
    border-radius: 0;
    resize: vertical;
  }

  .contact-form__field textarea {
    min-height: 96px;
  }

  .contact-form__field ::placeholder {
    color: var(--color-muted);
  }

  .contact-form__field:focus-within {
    border-bottom-color: var(--color-text);
  }

  .contact-form__field--select svg {
    position: absolute;
    right: 0;
    bottom: 24px;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }

  .contact-form__consent {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    cursor: pointer;
  }

  .contact-form__consent input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-text);
  }

  .contact-form__submit {
    width: 100%;
    margin-top: 32px;
  }

  .contact-form__status {
    min-height: 1.44em;
    margin-top: 16px;
    text-align: center;
  }

  @media (max-width: 809px) {
    .contact-form {
      margin-top: 56px;
    }

    .contact-form__grid {
      grid-template-columns: 1fr;
    }

    .contact-form__field:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>

<script>
  // Sitio estático: el formulario abre el cliente de correo con la consulta ya redactada.
  // Para un backend real, reemplaza este handler por un servicio de formularios.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-contact-form]")) {
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const email = form.dataset.email;
      if (!email) {
        if (status) status.textContent = "Configura un correo de contacto en src/config/site.ts.";
        return;
      }
      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? "").trim();
      const subject = `Consulta: ${value("type")} — ${value("name")}`;
      const body = [
        value("message"),
        "",
        `Nombre: ${value("name")}`,
        `Correo: ${value("email")}`,
        `Teléfono: ${value("phone") || "—"}`,
      ].join("\n");
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (status) status.textContent = "Abriendo tu aplicación de correo…";
    });
  }
</script>
