---
import BrandMark from "@/components/BrandMark.astro";
import ClosingCta from "@/components/ClosingCta.astro";
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ExperienceShowcase from "@/components/sections/ExperienceShowcase.astro";
import HomeHero from "@/components/sections/HomeHero.astro";
import ImageStatement from "@/components/sections/ImageStatement.astro";
import RoomsSlider from "@/components/sections/RoomsSlider.astro";
import StaggeredGallery from "@/components/sections/StaggeredGallery.astro";
import Ticker from "@/components/sections/Ticker.astro";
import { EXPERIENCES, IMAGES, ROOMS } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const highlights = [
  { label: "Bienestar", items: ["Piscina exterior", "Spa y masajes"] },
  { label: "La estancia", items: [`${ROOMS.length} habitaciones`, "Abierto todo el año"] },
];

const showcase = EXPERIENCES.filter((exp) => ["montana", "mar", "vida-local"].includes(exp.id));
---

<BaseLayout>
  <HomeHero
    image={IMAGES.homeHero}
    label="Un retiro privado"
    title="Lejos de todo"
    sideLeft="Entre montañas"
    sideRight="Ciudad, País"
    intro="Una casa de campo restaurada entre colinas y mar, pensada para bajar el ritmo."
  />

  <ImageStatement image={IMAGES.homeIntro} align="spread">
    <BrandMark />
    <div class="highlights" data-reveal>
      {
        highlights.map((block) => (
          <div class="highlights__block">
            <p class="t-label">{block.label}</p>
            <ul>
              {block.items.map((item) => (
                <li class="t-body">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <SectionHeading
      title="Bajar el ritmo"
      text="Mañanas lentas, comidas sin reloj y tardes a la sombra: aquí el tiempo se mide de otra manera."
    >
      <LinkButton href="/retreat" variant="primary" blockMobile>Conocer el retiro</LinkButton>
    </SectionHeading>
  </ImageStatement>

  <ImageStatement image={IMAGES.homeWellness}>
    <SectionHeading title="Pausa necesaria" sideLeft="Spa al aire libre" sideRight="Rituales diarios">
      <LinkButton href="/experience#bienestar" variant="primary" blockMobile>Ver bienestar</LinkButton>
    </SectionHeading>
  </ImageStatement>

  <RoomsSlider
    rooms={ROOMS}
    title="Dormir bien"
    text="Habitaciones y suites con materiales nobles, luz natural y vistas que invitan a quedarse."
  />

  <StaggeredGallery
    label="Cocina de temporada"
    title="Mesa compartida"
    text="Producto local, pescado del día y vinos de la zona en platos sencillos, pensados para compartir sin prisa."
    images={IMAGES.homeDining}
  />

  <ExperienceShowcase
    label="Experiencias"
    title="Salir a descubrir"
    image={IMAGES.homeExperiences}
    hoverImages={IMAGES.homeExperiencesHover}
    experiences={showcase}
  />

  <Ticker
    rows={[
      { text: "Montaña y mar", image: IMAGES.ticker[0] },
      { text: "Ciudad, País", image: IMAGES.ticker[1] },
    ]}
  />

  <ClosingCta />
</BaseLayout>

<style>
  .highlights {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 32px;
    width: 100%;
  }

  .highlights::before {
    content: "";
    grid-column: 2;
    grid-row: 1;
    background: currentColor;
  }

  .highlights__block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 12px 0;
    text-align: left;
  }

  .highlights__block:first-child {
    grid-column: 1;
    grid-row: 1;
    align-items: flex-end;
    text-align: right;
  }

  .highlights__block:last-child {
    grid-column: 3;
    grid-row: 1;
  }
</style>
