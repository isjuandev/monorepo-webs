---
import { StaySelector } from "@/components/StaySelector";
import { HOME, STAYS, UI_LABELS } from "@/data/content";

const options = STAYS.map(({ slug, name, guests, area, summary, image }) => ({
  slug,
  name,
  guests,
  area,
  summary,
  image,
}));
---

<section class="chooser">
  <div class="container chooser__inner">
    <header class="chooser__head">
      <p class="t-label">{HOME.stays.label}</p>
      <h2 class="t-h2">{HOME.stays.title}</h2>
    </header>
    <StaySelector
      client:visible
      stays={options}
      labels={{ group: UI_LABELS.staySelector, selected: UI_LABELS.selected }}
    />
  </div>
</section>

<style>
  .chooser__inner {
    padding-block: 80px;
  }

  .chooser__head {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 40px;
  }

  .chooser :global(.stay-selector) {
    display: grid;
    grid-template-columns: 403fr 669fr;
    gap: 48px;
    align-items: start;
  }

  .chooser :global(.stay-selector__options) {
    min-width: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chooser :global(.stay-selector__option) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-soft);
    text-align: left;
  }

  .chooser :global(.stay-selector__option[aria-pressed="true"]) {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-raised);
  }

  .chooser :global(.stay-selector__facts) {
    display: flex;
    gap: 16px;
  }

  .chooser :global(.stay-selector__preview) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .chooser :global(.stay-selector__media) {
    position: relative;
    width: 100%;
    aspect-ratio: 669 / 500;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .chooser :global(.stay-selector__media img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .chooser :global(.stay-selector__media img.is-active) {
    opacity: 1;
  }

  @media (max-width: 809px) {
    .chooser__inner {
      padding-block: 48px;
    }

    .chooser__head {
      gap: 24px;
      margin-bottom: 32px;
    }

    .chooser :global(.stay-selector) {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .chooser :global(.stay-selector__media) {
      aspect-ratio: 350 / 360;
    }
  }
</style>
