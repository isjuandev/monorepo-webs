---
import { EnquiryDraft } from "@/components/EnquiryDraft";
import PageIntro from "@/components/PageIntro.astro";
import { siteConfig } from "@/config/site";
import { EXPERIENCES, PAGES, STAYS, UI_LABELS } from "@/data/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const page = PAGES.enquire;
const options = [...STAYS, ...EXPERIENCES].map((item) => ({ value: item.slug, label: item.name }));
---

<BaseLayout page={page.seoTitle} description={page.description}>
  <PageIntro label={page.label} title={page.title} text={page.text} />
  <div class="enquiry-wrap">
    <EnquiryDraft
      client:load
      options={options}
      labels={UI_LABELS.form}
      recipient={siteConfig.contact.email}
    />
  </div>
</BaseLayout>

<style>
  .enquiry-wrap {
    max-width: 960px;
    margin-inline: auto;
    padding: 56px var(--gutter) 80px;
  }

  .enquiry-wrap :global(.enquiry) {
    font-family: var(--font-ui);
    font-size: 16px;
    line-height: 1.5;
  }

  .enquiry-wrap :global(.enquiry__notice) {
    margin-bottom: 28px;
    padding: 20px;
    border: 1px solid var(--color-primary);
  }

  .enquiry-wrap :global(.enquiry__grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 24px;
  }

  .enquiry-wrap :global(.enquiry__field) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .enquiry-wrap :global(.enquiry__field--wide) {
    grid-column: 1 / -1;
  }

  .enquiry-wrap :global(:is(input, select, textarea)) {
    width: 100%;
    min-width: 0;
    min-height: 52px;
    padding: 12px 14px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-field);
    color: var(--color-text);
  }

  .enquiry-wrap :global(:is(input, select, textarea):focus-visible),
  .enquiry-wrap :global(.enquiry__button:focus-visible) {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .enquiry-wrap :global([aria-invalid="true"]) {
    border-color: var(--color-primary);
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }

  .enquiry-wrap :global(.enquiry__error) {
    font-size: 14px;
  }

  .enquiry-wrap :global(.enquiry__button) {
    display: inline-flex;
    align-items: center;
    min-height: 54px;
    padding: 14px 22px;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-soft);
  }

  .enquiry-wrap :global(.enquiry__button--ghost) {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .enquiry-wrap :global(.enquiry__result) {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 32px;
  }

  .enquiry-wrap :global(.enquiry__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 809px) {
    .enquiry-wrap {
      padding-top: 48px;
    }
  }
</style>
